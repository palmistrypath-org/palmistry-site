---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { postId: string };

const { title, description, pubDate, updatedDate, heroImage, relatedLesson, cluster, postId } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

const articleSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description: description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	url: canonicalUrl,
	publisher: {
		'@type': 'Organization',
		name: 'Palmistry Path',
		url: 'https://palmistrypath.com',
	},
});

const breadcrumbSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Blog', item: 'https://palmistrypath.com/blog/' },
		{ '@type': 'ListItem', position: 2, name: title, item: canonicalUrl },
	],
});
---

<html lang="en">
	<head>
		<BaseHead title={`${title} — ${SITE_TITLE}`} description={description} type="article" />
		<script type="application/ld+json" set:html={articleSchema} />
		<script type="application/ld+json" set:html={breadcrumbSchema} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0 auto;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: var(--color-text);
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--color-text-muted);
			}
			.last-updated-on {
				font-style: italic;
			}
			.learn-cta {
				margin-top: 3em;
				padding: 1.35em 1.6em;
				border: 1px solid rgba(201, 169, 110, 0.25);
				border-radius: 8px;
				background: rgba(255, 255, 255, 0.02);
			}
			.learn-cta-eyebrow {
				font-family: var(--font-cinzel), serif;
				font-size: 0.63em;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: var(--accent);
				margin: 0 0 0.5em;
			}
			.learn-cta-body {
				font-size: 0.85em;
				color: var(--color-text-muted);
				margin: 0 0 1em;
				line-height: 1.7;
			}
			.learn-cta-links {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 0.7em;
			}
			.btn-lesson {
				display: inline-block;
				padding: 0.55em 1.25em;
				background: var(--accent);
				color: var(--color-bg);
				font-family: var(--font-cinzel), serif;
				font-size: 0.66em;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				text-decoration: none;
				border-radius: 4px;
				transition: background 0.15s ease;
			}
			.btn-lesson:hover {
				background: var(--accent-light);
			}
			.btn-guide-sm {
				font-size: 0.76em;
				color: var(--color-text-muted);
				text-decoration: none;
				border-bottom: 1px solid rgba(201, 169, 110, 0.3);
				transition: color 0.2s ease, border-color 0.2s ease;
			}
			.btn-guide-sm:hover {
				color: var(--accent);
				border-color: var(--accent);
			}
			@media (max-width: 480px) {
				.btn-lesson {
					width: 100%;
					text-align: center;
					box-sizing: border-box;
				}
			}
			/* Source notes — quieter reference styling */
			.prose hr ~ p em,
			.prose hr + p em {
				font-size: 0.78em;
				color: var(--color-text-muted);
				opacity: 0.75;
				line-height: 1.65;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
					{
						relatedLesson && (
							<aside class="learn-cta">
								<p class="learn-cta-eyebrow">Go deeper</p>
								<p class="learn-cta-body">
									This article is paired with a structured lesson in the Palmistry Path curriculum.
								</p>
								<div class="learn-cta-links">
									<a href={`${relatedLesson}/`} class="btn-lesson"
										data-track="cta" data-track-location="blog-lesson-cta" data-track-target="lesson">
										Continue with the structured lesson →
									</a>
									<a href="/guide/" class="btn-guide-sm"
										data-track="cta" data-track-location="blog-lesson-cta" data-track-target="guide">
										Download the free starter guide
									</a>
								</div>
							</aside>
						)
					}
					<RelatedArticles cluster={cluster} currentId={postId} />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
