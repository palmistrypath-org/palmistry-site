---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { postId: string; affiliate?: boolean };

const { title, description, pubDate, updatedDate, heroImage, relatedLesson, cluster, affiliate, postId } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

const articleSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description: description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	url: canonicalUrl,
	publisher: {
		'@type': 'Organization',
		name: 'Palmistry Path',
		url: 'https://palmistrypath.com',
	},
});

const breadcrumbSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Blog', item: 'https://palmistrypath.com/blog/' },
		{ '@type': 'ListItem', position: 2, name: title, item: canonicalUrl },
	],
});
---

<html lang="en">
	<head>
		<BaseHead title={`${title} — ${SITE_TITLE}`} description={description} type="article" />
		<script type="application/ld+json" set:html={articleSchema} />
		<script type="application/ld+json" set:html={breadcrumbSchema} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0 auto;
			}
			.hero-image {
				width: min(1020px, calc(100% - 2em));
				margin: 2em auto 0;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 6px;
				border: 1px solid var(--hairline);
				box-shadow: var(--box-shadow), 0 0 80px rgba(122, 72, 201, 0.15);
			}
			.article-opening {
				position: relative;
				isolation: isolate;
				overflow: hidden;
			}
			.article-opening::before {
				content: '';
				position: absolute;
				inset: 0;
				z-index: -1;
				background:
					radial-gradient(ellipse 50% 70% at 50% 0%, rgba(122, 72, 201, 0.18), transparent 70%),
					radial-gradient(ellipse 30% 30% at 50% 100%, rgba(201, 169, 110, 0.05), transparent 70%);
			}
			.prose {
				width: var(--measure);
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: var(--color-text);
			}
			.title {
				margin-bottom: 1.5em;
				padding: clamp(2em, 6vh, 3.5em) 0 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.6em 0;
				font-size: clamp(1.6rem, 5vw, 2.8em);
			}
			.title .divider-star {
				margin: 1.4em auto 0;
			}
			.date {
				margin-bottom: 1em;
				color: var(--color-text-muted);
				font-family: var(--font-cinzel), serif;
				font-size: 0.62em;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				line-height: 1.8;
			}
			.prose > :global(p:first-of-type)::first-letter {
				font-family: var(--font-cinzel), serif;
				font-size: 3.2em;
				line-height: 0.8;
				float: left;
				margin: 0.08em 0.14em 0 0;
				color: var(--accent-light);
				text-shadow: 0 0 24px rgba(201, 169, 110, 0.35);
			}
			.last-updated-on {
				font-style: italic;
			}
			.learn-cta {
				position: relative;
				margin-top: 3em;
				padding: 1.6em 1.8em;
				border: 1px solid var(--hairline-strong);
				border-radius: 4px;
				background:
					radial-gradient(ellipse 60% 80% at 0% 0%, rgba(201, 169, 110, 0.1), transparent 70%),
					linear-gradient(180deg, rgba(122, 72, 201, 0.08), transparent 60%),
					var(--color-bg-elev);
				box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
			}
			.learn-cta::before {
				content: '';
				position: absolute;
				top: -1px;
				left: 12%;
				right: 12%;
				height: 1px;
				background: linear-gradient(90deg, transparent, var(--accent-light), transparent);
			}
			.learn-cta-eyebrow {
				font-family: var(--font-cinzel), serif;
				font-size: 0.63em;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: var(--accent);
				margin: 0 0 0.5em;
			}
			.learn-cta-body {
				font-size: 0.85em;
				color: var(--color-text-muted);
				margin: 0 0 1em;
				line-height: 1.7;
			}
			.learn-cta-links {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 0.7em;
			}
			.btn-lesson {
				display: inline-block;
				padding: 0.55em 1.25em;
				background: linear-gradient(180deg, var(--accent-light), var(--accent));
				color: var(--color-bg);
				font-family: var(--font-cinzel), serif;
				font-size: 0.66em;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				text-decoration: none;
				border-radius: 3px;
				border: 1px solid rgba(201, 169, 110, 0.6);
				box-shadow: 0 6px 24px rgba(201, 169, 110, 0.18);
				transition: background 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
			}
			.btn-lesson:hover {
				background: linear-gradient(180deg, var(--accent-bright), var(--accent-light));
				box-shadow: 0 8px 36px rgba(201, 169, 110, 0.32);
			}
			.btn-guide-sm {
				font-size: 0.76em;
				color: var(--color-text-muted);
				text-decoration: none;
				border-bottom: 1px solid rgba(201, 169, 110, 0.3);
				transition: color 0.2s ease, border-color 0.2s ease;
			}
			.btn-guide-sm:hover {
				color: var(--accent);
				border-color: var(--accent);
			}
			@media (max-width: 480px) {
				.btn-lesson {
					width: 100%;
					text-align: center;
					box-sizing: border-box;
				}
			}
			/* Source notes — quieter reference styling */
			.prose hr ~ p em,
			.prose hr + p em {
				font-size: 0.78em;
				color: var(--color-text-muted);
				line-height: 1.65;
			}
			/* Affiliate notice */
			.affiliate-notice {
				font-size: 0.78em;
				color: var(--color-text-muted);
				border-left: 2px solid rgba(201, 169, 110, 0.22);
				padding: 0.55em 1em;
				margin-bottom: 2em;
				line-height: 1.65;
			}
			.affiliate-notice a {
				color: var(--color-text-muted);
				text-decoration: underline;
				text-underline-offset: 2px;
				text-decoration-color: rgba(201, 169, 110, 0.3);
				transition: color 0.2s ease, text-decoration-color 0.2s ease;
			}
			.affiliate-notice a:hover {
				color: var(--accent);
				text-decoration-color: rgba(201, 169, 110, 0.6);
			}
			/* Affiliate buy links inside article content */
			:global(.book-buy-link) {
				display: inline-block;
				font-family: var(--font-cinzel), serif;
				font-size: 0.67em;
				letter-spacing: 0.09em;
				text-transform: uppercase;
				color: var(--color-bg);
				background: var(--accent);
				text-decoration: none;
				padding: 0.42em 1.1em;
				border-radius: 3px;
				margin: 0.5em 0 0.25em;
				transition: background 0.2s ease;
			}
			:global(.book-buy-link:hover) {
				background: var(--accent-light);
				text-decoration: none;
			}
		</style>
	</head>

	<body>
		<Header />
		<main id="main-content" tabindex="-1">
			<article>
				<div class="article-opening">
					<div class="hero-image reveal reveal--scale">
						{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
					</div>
					<div class="prose">
						<div class="title">
							<div class="date reveal">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1 class="display reveal" style="--reveal-delay: 120ms">{title}</h1>
							<div class="divider-star reveal reveal--line" style="--reveal-delay: 240ms" aria-hidden="true"></div>
						</div>
					</div>
				</div>
				<div class="prose">
					{affiliate && (
						<p class="affiliate-notice">
							This article contains affiliate links. If you buy through them, we earn a small commission at no extra cost to you. <a href="/affiliate-disclosure/">Affiliate disclosure.</a>
						</p>
					)}
					<slot />
					{
						relatedLesson && (
							<aside class="learn-cta">
								<p class="learn-cta-eyebrow">Go deeper</p>
								<p class="learn-cta-body">
									This article is paired with a structured lesson in the Palmistry Path curriculum.
								</p>
								<div class="learn-cta-links">
									<a href={`${relatedLesson}/`} class="btn-lesson"
										data-track="cta" data-track-location="blog-lesson-cta" data-track-target="lesson">
										Continue with the structured lesson →
									</a>
									<a href="/guide/" class="btn-guide-sm"
										data-track="cta" data-track-location="blog-lesson-cta" data-track-target="guide">
										Download the free starter guide
									</a>
								</div>
							</aside>
						)
					}
					<RelatedArticles cluster={cluster} currentId={postId} />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
