---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import EditorialHero from '../components/EditorialHero.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { SITE_TITLE } from '../consts';
import { getArticleVisual } from '../data/visuals';

type Props = CollectionEntry<'blog'>['data'] & { postId: string; affiliate?: boolean };

const { title, description, pubDate, updatedDate, heroImage, relatedLesson, cluster, affiliate, postId } = Astro.props;
const articleVisual = getArticleVisual(postId, cluster);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

const articleSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description: description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	url: canonicalUrl,
	publisher: {
		'@type': 'Organization',
		name: 'Palmistry Path',
		url: 'https://palmistrypath.com',
	},
});

const breadcrumbSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Blog', item: 'https://palmistrypath.com/blog/' },
		{ '@type': 'ListItem', position: 2, name: title, item: canonicalUrl },
	],
});
---

<html lang="en">
	<head>
		<BaseHead title={`${title} — ${SITE_TITLE}`} description={description} image={heroImage ?? articleVisual.src} type="article" />
		<script type="application/ld+json" set:html={articleSchema} />
		<script type="application/ld+json" set:html={breadcrumbSchema} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0 auto;
			}
			.article-hero-wrap {
				width: min(1180px, calc(100% - 3rem));
				margin: 2.5rem auto 0;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: var(--color-text);
			}
			.article-date {
				margin: 1.2rem 0 0;
				font-size: 0.72em;
				color: var(--color-text-secondary);
			}
			.last-updated-on {
				font-style: italic;
			}
			.learn-cta {
				margin-top: 3em;
				padding: 1.35em 1.6em;
				border: 1px solid var(--color-border);
				border-radius: 8px;
				background: var(--color-surface);
			}
			.learn-cta-eyebrow {
				font-family: var(--font-cinzel), serif;
				font-size: 0.63em;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: var(--accent);
				margin: 0 0 0.5em;
			}
			.learn-cta-body {
				font-size: 0.85em;
				color: var(--color-text-muted);
				margin: 0 0 1em;
				line-height: 1.7;
			}
			.learn-cta-links {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 0.7em;
			}
			.btn-lesson {
				display: inline-block;
				padding: 0.55em 1.25em;
				background: var(--color-cta-bg);
				color: var(--color-cta-text);
				font-family: var(--font-cinzel), serif;
				font-size: 0.66em;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				text-decoration: none;
				border-radius: 4px;
				transition: background 0.15s ease;
			}
			.btn-lesson:hover {
				background: var(--color-cta-hover);
				color: var(--color-cta-text);
			}
			.btn-guide-sm {
				font-size: 0.76em;
				color: var(--color-text-muted);
				text-decoration: none;
				border-bottom: 1px solid var(--color-border-strong);
				transition: color 0.2s ease, border-color 0.2s ease;
			}
			.btn-guide-sm:hover {
				color: var(--accent);
				border-color: var(--accent);
			}
			@media (max-width: 480px) {
				.btn-lesson {
					width: 100%;
					text-align: center;
					box-sizing: border-box;
				}
			}
			/* Source notes — quieter reference styling */
			.prose hr ~ p em,
			.prose hr + p em {
				font-size: 0.78em;
				color: var(--color-text-muted);
				line-height: 1.65;
			}
			/* Affiliate notice */
			.affiliate-notice {
				font-size: 0.78em;
				color: var(--color-text-muted);
				border-left: 2px solid var(--color-border-strong);
				padding: 0.55em 1em;
				margin-bottom: 2em;
				line-height: 1.65;
			}
			.affiliate-notice a {
				color: var(--color-text-muted);
				text-decoration: underline;
				text-underline-offset: 2px;
				text-decoration-color: var(--color-border-strong);
				transition: color 0.2s ease, text-decoration-color 0.2s ease;
			}
			.affiliate-notice a:hover {
				color: var(--accent);
				text-decoration-color: var(--color-teal);
			}
			/* Affiliate buy links inside article content */
			:global(.book-buy-link) {
				display: inline-block;
				font-family: var(--font-cinzel), serif;
				font-size: 0.67em;
				letter-spacing: 0.09em;
				text-transform: uppercase;
				color: var(--color-cta-text);
				background: var(--color-cta-bg);
				text-decoration: none;
				padding: 0.42em 1.1em;
				border-radius: 3px;
				margin: 0.5em 0 0.25em;
				transition: background 0.2s ease;
			}
			:global(.book-buy-link:hover) {
				background: var(--color-cta-hover);
				text-decoration: none;
			}
		</style>
	</head>

	<body>
		<Header />
		<main id="main-content" tabindex="-1">
			<article>
				<div class="article-hero-wrap">
					<EditorialHero title={title} description={description} visual={articleVisual}>
						<div class="article-date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
					</EditorialHero>
				</div>
				<div class="prose">
					{affiliate && (
						<p class="affiliate-notice">
							This article contains affiliate links. If you buy through them, we earn a small commission at no extra cost to you. <a href="/affiliate-disclosure/">Affiliate disclosure.</a>
						</p>
					)}
					<slot />
					{
						relatedLesson && (
							<aside class="learn-cta">
								<p class="learn-cta-eyebrow">Go deeper</p>
								<p class="learn-cta-body">
									This article is paired with a structured lesson in the Palmistry Path curriculum.
								</p>
								<div class="learn-cta-links">
									<a href={`${relatedLesson}/`} class="btn-lesson"
										data-track="cta" data-track-location="blog-lesson-cta" data-track-target="lesson">
										Continue with the structured lesson →
									</a>
									<a href="/guide/" class="btn-guide-sm"
										data-track="cta" data-track-location="blog-lesson-cta" data-track-target="guide">
										Download the free starter guide
									</a>
								</div>
							</aside>
						)
					}
					<RelatedArticles cluster={cluster} currentId={postId} />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
