					</div>
					<div class="obs-field">
						<div class="obs-label">Fate line (present? origin / path)</div>
						<div class="obs-lines"><div class="obs-line"></div></div>
					</div>
					<div class="obs-field">
						<div class="obs-label">Minor lines noted</div>
						<div class="obs-lines"><div class="obs-line"></div></div>
					</div>
