					</div>
					<div class="obs-field">
						<div class="obs-label">Dominant mount(s)</div>
						<div class="obs-lines"><div class="obs-line"></div></div>
					</div>
					<div class="obs-field">
						<div class="obs-label">Heart line (length / path / markings)</div>
						<div class="obs-lines"><div class="obs-line"></div><div class="obs-line"></div></div>
					</div>
					<div class="obs-field">
						<div class="obs-label">Head line (length / curve / start)</div>
						<div class="obs-lines"><div class="obs-line"></div><div class="obs-line"></div></div>
					</div>
					<div class="obs-field">
						<div class="obs-label">Life line (arc / markings / branches)</div>
