---
import type { EditorialVisual } from '../data/visuals';

interface Props {
	title: string;
	description?: string;
	visual: EditorialVisual;
	compact?: boolean;
}

const { title, description, visual, compact = false } = Astro.props;
---

<header class:list={['editorial-hero', { compact }]}>
	<img
		src={visual.src}
		alt={visual.alt}
		width="1440"
		height="804"
		loading="eager"
		decoding="async"
		fetchpriority="high"
		style={visual.position ? `object-position: ${visual.position}` : undefined}
	/>
	<div class="editorial-hero-copy">
		<p class="editorial-hero-eyebrow">{visual.eyebrow}</p>
		<h1>{title}</h1>
		{description && <p class="editorial-hero-description">{description}</p>}
		<slot />
	</div>
</header>

<style>
	.editorial-hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
		min-height: 24rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		overflow: hidden;
		box-shadow: var(--box-shadow);
	}
	.editorial-hero.compact {
		min-height: 18rem;
	}
	.editorial-hero > img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}
	.editorial-hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, rgba(255, 250, 241, 0.03) 34%, rgba(255, 250, 241, 0.86) 58%, rgba(255, 250, 241, 0.99) 100%);
	}
	.editorial-hero-copy {
		position: relative;
		z-index: 1;
		grid-column: 2;
		align-self: center;
		padding: clamp(2rem, 5vw, 4.5rem);
	}
	.editorial-hero-eyebrow {
		margin: 0 0 0.7rem;
		font-family: var(--font-cinzel), serif;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-teal-dark);
	}
	.editorial-hero h1 {
		font-size: clamp(1.7rem, 4vw, 3rem);
		letter-spacing: 0.015em;
		margin: 0;
	}
	.editorial-hero-description {
		margin: 1rem 0 0;
		font-size: 0.88em;
		line-height: 1.65;
		color: var(--color-text-secondary);
	}
	@media (max-width: 740px) {
		.editorial-hero,
		.editorial-hero.compact {
			display: flex;
			flex-direction: column;
			min-height: 0;
		}
		.editorial-hero > img {
			position: static;
			width: 100%;
			height: auto;
			aspect-ratio: 16 / 9;
			object-position: center;
		}
		.editorial-hero::after {
			display: none;
		}
		.editorial-hero-copy {
			width: 100%;
			box-sizing: border-box;
			padding: 2rem 1.35rem;
		}
	}
</style>
