---
const today = new Date();
---

<footer>
	<p class="tagline">✦ · ✦ · ✦</p>
	<p>&copy; {today.getFullYear()} Palmistry Path. All rights reserved.</p>
	<nav class="footer-nav" aria-label="Legal and policy links">
		<a href="/privacy/" data-track="nav" data-track-location="footer" data-track-target="privacy">Privacy</a>
		<span aria-hidden="true">·</span>
		<a href="/terms/" data-track="nav" data-track-location="footer" data-track-target="terms">Terms</a>
		<span aria-hidden="true">·</span>
		<a href="/disclaimer/" data-track="nav" data-track-location="footer" data-track-target="disclaimer">Disclaimer</a>
		<span aria-hidden="true">·</span>
		<a href="/contact/" data-track="nav" data-track-location="footer" data-track-target="contact">Contact</a>
	</nav>
	<p class="sub">Read the lines. Discover the path.</p>
</footer>
<style>
	footer {
		padding: 3em 1em 3.5em;
		background: var(--color-header-bg);
		border-top: 1px solid rgba(201, 169, 110, 0.12);
		color: var(--color-nav-text);
		text-align: center;
	}
	footer p {
		margin: 0.3em 0;
		font-size: 0.85em;
		opacity: 0.65;
	}
	.tagline {
		color: var(--accent);
		letter-spacing: 0.4em;
		font-size: 0.65em !important;
		opacity: 0.45 !important;
		margin-bottom: 1em !important;
	}
	.footer-nav {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.6em;
		margin: 0.75em 0 0.5em;
		flex-wrap: wrap;
	}
	.footer-nav a {
		font-size: 0.75em;
		color: var(--color-text-muted);
		text-decoration: none;
		opacity: 0.65;
		transition: color 0.2s ease, opacity 0.2s ease;
	}
	.footer-nav a:hover {
		color: var(--accent);
		opacity: 1;
	}
	.footer-nav span {
		font-size: 0.65em;
		color: var(--color-text-muted);
		opacity: 0.35;
	}
	.sub {
		font-family: var(--font-cinzel), serif;
		font-size: 0.7em !important;
		letter-spacing: 0.15em;
		opacity: 0.35 !important;
		margin-top: 0.5em !important;
	}
</style>
