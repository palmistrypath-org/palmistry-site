---
/**
 * PageOpening — the shared opening for every page that isn't a lesson or an
 * article: eyebrow, display title, optional lede, star divider, with the
 * site's haze behind and one of the wireframe hands hanging faintly in the
 * dark. Gives every surface the same first breath, so no page opens as a
 * bare heading on black.
 */
interface Props {
	title: string;
	eyebrow?: string;
	lede?: string;
	/** Which wireframe hand sits behind the title. `none` for a quieter opening. */
	art?: 'foundations' | 'lines' | 'mounts' | 'advanced' | 'palm' | 'none';
	/** Tighter vertical rhythm for utility and legal pages. */
	compact?: boolean;
}
const { title, eyebrow, lede, art = 'palm', compact = false } = Astro.props;

const ART: Record<string, string> = {
	foundations: '/images/home/path-foundations.webp',
	lines: '/images/home/path-lines.webp',
	mounts: '/images/home/path-mounts.webp',
	advanced: '/images/home/path-advanced.webp',
	palm: '/images/home/hero-palm-map.webp',
};
const artSrc = art === 'none' ? null : ART[art];
---

<div class={`page-opening${compact ? ' page-opening--compact' : ''}`}>
	{artSrc && (
		<div class="opening-art" aria-hidden="true">
			<img src={artSrc} alt="" width="640" height="640" loading="eager" decoding="async" />
		</div>
	)}
	<div class="opening-inner">
		{eyebrow && <p class="eyebrow reveal">{eyebrow}</p>}
		<h1 class="display reveal" style="--reveal-delay: 120ms">{title}</h1>
		{lede && <p class="lede reveal" style="--reveal-delay: 240ms">{lede}</p>}
		<div class="divider-star reveal reveal--line" style="--reveal-delay: 340ms" aria-hidden="true"></div>
		<slot />
	</div>
</div>

<style>
	.page-opening {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: clamp(2.5em, 7vh, 4.5em) 1em 1.5em;
		margin: 0 0 1.5em;
		text-align: center;
	}
	.page-opening--compact {
		padding-top: clamp(1.8em, 4vh, 2.6em);
		padding-bottom: 0.6em;
	}
	.opening-inner {
		width: var(--wide);
		max-width: calc(100% - 2em);
		margin: 0 auto;
	}
	.page-opening::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -2;
		background:
			radial-gradient(ellipse 45% 60% at 50% 30%, rgba(122, 72, 201, 0.16), transparent 70%),
			radial-gradient(ellipse 30% 30% at 50% 100%, rgba(201, 169, 110, 0.05), transparent 70%);
	}
	.opening-art {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
	}
	.opening-art img {
		position: absolute;
		top: 50%;
		left: 50%;
		width: min(560px, 110vw);
		height: auto;
		transform: translate(-50%, -44%);
		opacity: 0.16;
		filter: saturate(0.9);
		mask-image: radial-gradient(ellipse 50% 60% at 50% 50%, #000 25%, transparent 72%);
		-webkit-mask-image: radial-gradient(ellipse 50% 60% at 50% 50%, #000 25%, transparent 72%);
	}
	.page-opening--compact .opening-art img {
		opacity: 0.1;
		width: min(420px, 100vw);
	}
	.opening-art::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 55%, var(--color-bg) 100%);
	}
	h1 {
		margin: 0 0 0.4em;
		font-size: clamp(1.7rem, 5vw, 2.9em);
	}
	.lede {
		max-width: 620px;
		margin: 0 auto;
		font-size: 1.02em;
		line-height: 1.8;
		color: var(--color-text-muted);
	}
	.divider-star {
		margin-top: 1.6em;
	}
	.page-opening--compact .divider-star {
		margin-top: 1.1em;
	}
</style>
