---
/**
 * The Palmistry Path mark: an open hand drawn as one fine gold contour with
 * the heart, head and life lines inside and a four-point star at its shoulder.
 * The wrist is left open, so it reads as a drawing rather than a glove.
 *
 * Generated by scripts/generate-brand-mark.mjs. Edit the geometry there and
 * re-run; do not hand-edit the path data.
 *
 * Props: `size` is the rendered height in px. The stroke is set in px so the
 * mark keeps the same line quality at 20px and 60px. `star` toggles the star.
 */
interface Props {
	size?: number;
	class?: string;
	star?: boolean;
}
const { size = 24, class: className = '', star = true } = Astro.props;
const VB = { x: 0, y: 2, w: 98, h: 114 };
const width = Math.round((size * VB.w) / VB.h);
const px = size <= 28 ? 1.15 : size <= 44 ? 1.4 : 1.6;
const sw = (px * VB.h) / size;
const fine = sw * 0.72;
---

<svg
	class={`brand-mark ${className}`.trim()}
	width={width}
	height={size}
	viewBox={`${VB.x} ${VB.y} ${VB.w} ${VB.h}`}
	aria-hidden="true"
	fill="none"
	stroke="currentColor"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	<path d="M 27 113 C 24 104 14 93 19.68 80.38 L 2.93 52.41 A 5.42 5.42 0 0 1 12.07 46.59 L 26.52 68 C 28.02 65.5 24.58 65 24.88 62.5 L 22.19 20.45 A 5.33 5.33 0 0 1 32.81 19.55 L 36.86 57.5 C 37.16 60.1 38.34 60.1 38.64 57.5 L 40 10.44 A 5.5 5.5 0 0 1 51 10.56 L 51.38 56.5 C 51.68 59.1 52.85 59.1 53.15 56.5 L 56.26 15.7 A 5.25 5.25 0 0 1 66.74 16.3 L 65.08 60.5 C 65.38 63.1 67.06 63.1 67.36 60.5 L 74.03 31.09 A 4.56 4.56 0 0 1 82.97 32.91 L 77.02 66 C 83.02 74 84 96 75 113" stroke-width={sw} />
	<g stroke-width={fine} opacity={size <= 28 ? 0.62 : 0.78}>
		<path d="M 76 73 C 64 69 50 68 37 64" />
		{size > 28 && <path d="M 27 71 C 40 74 55 79 68 86" />}
		<path d="M 28 70 C 20 84 24 100 37 111" />
	</g>
	{star && (
		<g fill="currentColor" stroke="none">
			<path d="M 90 17 Q 91.2 20.8 95 22 Q 91.2 23.2 90 27 Q 88.8 23.2 85 22 Q 88.8 20.8 90 17 Z" />
			<path d="M 12 29.6 Q 12.58 31.42 14.4 32 Q 12.58 32.58 12 34.4 Q 11.42 32.58 9.6 32 Q 11.42 31.42 12 29.6 Z" opacity="0.6" />
		</g>
	)}
</svg>
