---
/**
 * The Palmistry Path mark: an open palm, drawn as a single gold contour, with
 * the three major lines and a small star. One asset, used everywhere a mark
 * is needed (header, footer, lesson callouts) so the brand reads the same at
 * 20px and at 60px.
 *
 * Sizes: `size` is the rendered height in px; width follows the 40×48 box.
 */
interface Props {
	size?: number;
	class?: string;
	/** Draw the small star beside the thumb (off for the tiniest sizes). */
	star?: boolean;
}
const { size = 24, class: className = '', star = true } = Astro.props;
const width = Math.round((size * 40) / 48);
---

<svg
	class={`brand-mark ${className}`.trim()}
	width={width}
	height={size}
	viewBox="0 0 40 48"
	aria-hidden="true"
	fill="none"
	stroke="currentColor"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	<!-- palm and fingers -->
	<path
		d="M 11 46 C 9 40 8 34 9 28 C 5.5 25.5 2.5 21.5 3.2 17.5 C 3.8 14.6 6.8 14.2 8.6 16.6 C 10.4 19 11.8 21.4 13 23.4 C 13 19.6 13 15 13.2 11 C 13.3 8 18 8 18.2 11 C 18.4 15.4 18.5 19.6 18.7 23.4 C 19 18 19.2 11 19.4 6 C 19.5 3 24.3 3 24.4 6 C 24.6 11 24.8 18 25 23.6 C 25.3 19 25.5 13.5 25.7 9 C 25.8 6.2 30.4 6.2 30.5 9 C 30.7 13.6 30.9 19.4 31 24.6 C 31.2 21.4 31.4 18 31.6 15 C 31.8 12.4 35.8 12.4 36 15 C 36.2 20 35.8 25 35 30 C 34.4 36 33.8 41.5 33 46 C 26 47.4 18 47.4 11 46 Z"
		stroke-width="1.6"
	/>
	<!-- heart, head, life -->
	<path d="M 32.5 30.5 C 27.5 29.5 22.5 30.5 17.5 33.5" stroke-width="1.1" opacity="0.85" />
	<path d="M 13.5 30.5 C 19 33 24.5 35.5 29.5 38.5" stroke-width="1.1" opacity="0.7" />
	<path d="M 14 27 C 12.2 33 12.8 39.5 18 45" stroke-width="1.1" opacity="0.7" />
	{star && (
		<path d="M 6.5 5.5 l 1 2.6 2.6 1 -2.6 1 -1 2.6 -1 -2.6 -2.6 -1 2.6 -1 z" fill="currentColor" stroke="none" opacity="0.8" />
	)}
</svg>
