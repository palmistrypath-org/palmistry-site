---
interface LessonLink {
	href: string;
	title: string;
	description?: string;
}

interface Props {
	prevLesson: { href: string; title: string } | null;
	nextLesson: LessonLink | null;
}

const { prevLesson, nextLesson } = Astro.props;
---

<div class="lesson-footer">
	<div class="footer-haze" aria-hidden="true"></div>
	<div class="complete-row reveal" aria-label="Lesson complete">
		<span class="complete-pip" aria-hidden="true">✦</span>
		<span class="complete-label">Lesson complete</span>
		<span class="complete-pip" aria-hidden="true">✦</span>
	</div>

	{
		nextLesson ? (
			<div class="next-block reveal" style="--reveal-delay: 120ms">
				<p class="next-eyebrow">Next</p>
				<p class="next-title">{nextLesson.title}</p>
				{nextLesson.description && <p class="next-desc">{nextLesson.description}</p>}
				<a href={nextLesson.href} class="btn-continue"
					data-track="cta" data-track-location="lesson-footer" data-track-target="next-lesson">
					Continue to {nextLesson.title} →
				</a>
			</div>
		) : (
			<div class="next-block reveal" style="--reveal-delay: 120ms">
				<p class="next-eyebrow">Module complete</p>
				<p class="next-title">You've finished this module.</p>
				<a href="/learn" class="btn-continue"
					data-track="cta" data-track-location="lesson-footer" data-track-target="learn">
					Explore what's next →
				</a>
			</div>
		)
	}

	{
		prevLesson && (
			<p class="prev-row">
				<a href={prevLesson.href} class="prev-link"
					data-track="nav" data-track-location="lesson-footer" data-track-target="prev-lesson">
					← {prevLesson.title}
				</a>
			</p>
		)
	}

	<aside class="email-card reveal" aria-label="Free starter guide">
		<div class="email-art" aria-hidden="true"><img src="/images/guide/quick-start-cover.webp" alt="" width="900" height="1336" loading="lazy" decoding="async" /></div>
		<div class="email-inner">
			<p class="email-eyebrow" aria-hidden="true">✦</p>
			<h2 class="email-title">Get the Palmistry Starter Guide</h2>
			<p class="email-body">
				A printable quick-reference guide to the major lines, mounts, and hand shapes.
			</p>
			<div class="includes" aria-label="Guide contents">
				<p class="includes-label">Includes</p>
				<ul class="includes-list">
					<li>Major lines quick-reference map</li>
					<li>Mount meanings overview</li>
					<li>Hand shape guide</li>
					<li>Printable study sheet</li>
				</ul>
			</div>
			<a href="/guide/" class="btn-guide"
				data-track="cta" data-track-location="lesson-footer" data-track-target="guide">Get the Free Guide</a>
		</div>
	</aside>
</div>

<style>
	.lesson-footer {
		position: relative;
		isolation: isolate;
		width: var(--measure);
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 3em 1em 5em;
	}
	.lesson-footer::before {
		content: '';
		position: absolute;
		top: 0;
		left: 15%;
		right: 15%;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(201, 169, 110, 0.55), transparent);
	}
	.footer-haze {
		position: absolute;
		inset: -10% -40% 0;
		z-index: -1;
		pointer-events: none;
		background: radial-gradient(ellipse 50% 50% at 50% 30%, rgba(122, 72, 201, 0.14), transparent 70%);
	}

	/* ── Lesson complete marker ── */
	.complete-row {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75em;
		margin-bottom: 2.25em;
		color: var(--accent);
	}
	.complete-pip {
		font-size: 0.6em;
		opacity: 0.6;
	}
	.complete-label {
		font-family: var(--font-cinzel), serif;
		font-size: 0.68em;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--accent-light);
		text-shadow: 0 0 20px rgba(201, 169, 110, 0.35);
	}

	/* ── Next lesson block ── */
	.next-block {
		text-align: center;
		margin-bottom: 1.75em;
	}
	.next-eyebrow {
		font-family: var(--font-cinzel), serif;
		font-size: 0.64em;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin: 0 0 0.45em;
	}
	.next-title {
		font-family: var(--font-cinzel), serif;
		font-size: clamp(1em, 4vw, 1.2em);
		color: var(--color-heading);
		margin: 0 0 0.5em;
		line-height: 1.3;
	}
	.next-desc {
		font-size: 0.84em;
		color: var(--color-text-muted);
		max-width: 460px;
		margin: 0 auto 1.35em;
		line-height: 1.7;
	}

	.btn-continue {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		box-sizing: border-box;
		padding: 0.7em 1.9em;
		background: linear-gradient(180deg, var(--accent-light), var(--accent));
		color: var(--color-bg);
		font-family: var(--font-cinzel), serif;
		font-size: 0.7em;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
		border-radius: 3px;
		border: 1px solid rgba(201, 169, 110, 0.6);
		box-shadow: 0 6px 24px rgba(201, 169, 110, 0.18);
		transition: background 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out), transform 0.3s var(--ease-out);
	}
	.btn-continue:hover {
		background: linear-gradient(180deg, var(--accent-bright), var(--accent-light));
		color: var(--color-bg);
		box-shadow: 0 8px 36px rgba(201, 169, 110, 0.32);
		transform: translateY(-1px);
	}

	/* ── Previous link ── */
	.prev-row {
		text-align: center;
		margin-top: 1.1em;
		margin-bottom: 0;
	}
	.prev-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-size: 0.78em;
		color: var(--color-text-muted);
		text-decoration: none;
	}
	.prev-link:hover {
		color: var(--accent);
	}

	/* ── Email capture card ── */
	.email-card {
		position: relative;
		margin-top: 3.5em;
		border: 1px solid var(--hairline);
		border-radius: 6px;
		background:
			radial-gradient(ellipse 60% 80% at 100% 50%, rgba(122, 72, 201, 0.16), transparent 70%),
			var(--color-bg-elev);
		display: grid;
		grid-template-columns: 1fr 190px;
		overflow: hidden;
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
	}
	.email-art {
		position: relative;
		order: 2;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		padding: 2em 1.2em 0;
		perspective: 900px;
	}
	.email-art img {
		width: 140px;
		height: auto;
		transform: rotateY(-14deg) rotateX(3deg) translateY(10px);
		border-radius: 3px 6px 6px 3px;
		box-shadow: -14px 20px 40px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(201, 169, 110, 0.3), 0 0 50px rgba(122, 72, 201, 0.3);
	}
	.email-inner {
		padding: 2em 2em 2.25em;
		text-align: center;
	}
	@media (max-width: 600px) {
		.email-card {
			grid-template-columns: 1fr;
		}
		.email-art {
			order: 0;
			padding: 1.5em 0 0;
		}
		.email-art img {
			transform: none;
			width: 120px;
		}
	}
	.email-eyebrow {
		font-size: 0.65em;
		color: var(--accent);
		opacity: 0.75;
		margin: 0 0 0.75em;
		letter-spacing: 0.3em;
	}
	.email-title {
		font-family: var(--font-cinzel), serif;
		font-size: clamp(0.95em, 3.5vw, 1.25em);
		color: var(--color-heading);
		margin: 0 0 0.55em;
		letter-spacing: 0.04em;
		line-height: 1.3;
	}
	.email-body {
		font-size: 0.83em;
		color: var(--color-text-muted);
		max-width: 400px;
		margin: 0 auto 1em;
		line-height: 1.75;
	}

	/* ── Includes list ── */
	.includes {
		margin: 0 auto 1.6em;
		max-width: 260px;
		text-align: left;
	}
	.includes-label {
		font-family: var(--font-cinzel), serif;
		font-size: 0.57em;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin: 0 0 0.6em;
	}
	.includes-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.28em;
	}
	.includes-list li {
		font-size: 0.76em;
		color: var(--color-text-muted);
		padding-left: 0.9em;
		position: relative;
		line-height: 1.5;
	}
	.includes-list li::before {
		content: '·';
		position: absolute;
		left: 0;
		color: var(--accent);
		opacity: 0.4;
	}

	.btn-guide {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		box-sizing: border-box;
		padding: 0.65em 1.65em;
		border: 1px solid rgba(201, 169, 110, 0.4);
		color: var(--accent);
		font-family: var(--font-cinzel), serif;
		font-size: 0.68em;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		border-radius: 4px;
		transition:
			border-color 0.25s ease,
			background 0.25s ease,
			color 0.25s ease,
			box-shadow 0.25s ease;
	}
	.btn-guide:hover {
		border-color: rgba(201, 169, 110, 0.65);
		background: rgba(201, 169, 110, 0.07);
		color: var(--accent-light);
		box-shadow: 0 0 18px rgba(201, 169, 110, 0.1);
	}

	@media (max-width: 480px) {
		.email-inner {
			padding: 1.5em 1.25em 1.75em;
		}
		.btn-continue,
		.btn-guide {
			width: 100%;
			text-align: center;
			box-sizing: border-box;
		}
	}
</style>
