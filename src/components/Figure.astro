---
/**
 * Figure — a diagram plate. Markup only; the plate styles live in
 * global.css ("Figure plates") so that markdown images, which the
 * rehype-figure plugin wraps in the same markup, look identical.
 */
interface Props {
	src: string;
	alt: string;
	caption?: string;
	/** `inset` = a narrower plate for close-ups; default fills the measure. */
	size?: 'inset';
}

const { src, alt, caption, size } = Astro.props;
const cls = `pp-figure reveal reveal--scale${size ? ` pp-figure--${size}` : ''}`;
---

<figure class={cls}>
	<div class="pp-figure-frame">
		<img src={src} alt={alt} loading="lazy" decoding="async" />
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>
