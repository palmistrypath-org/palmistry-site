---
interface Props {
	src: string;
	alt: string;
	caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure>
	<img src={src} alt={alt} loading="lazy" decoding="async" />
	{caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
	figure {
		margin: 2em 0;
		padding: 0;
		overflow: hidden;
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		line-height: 0;
	}
	figure > img {
		display: block;
		width: calc(100% + 2px);
		max-width: none;
		height: auto;
		margin: -1px;
		border-radius: 0 !important;
	}
	figure > figcaption {
		display: block;
		margin-top: 0.75em;
		font-size: 0.8em;
		color: var(--color-text-muted);
		font-style: italic;
		line-height: 1.5;
		text-align: center;
	}
</style>
