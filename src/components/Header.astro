---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<a class="skip-link" href="#main-content">Skip to main content</a>
<header>
	<nav aria-label="Site navigation">
		<p class="site-title">
		<a href="/">
			<svg class="brand-mark" width="13" height="16" viewBox="0 0 13 16" aria-hidden="true" fill="none">
				<ellipse cx="6.5" cy="9" rx="5" ry="6.5" stroke="currentColor" stroke-width="0.7" opacity="0.38"/>
				<path d="M 10 6 C 7.5 5 4 5 2.5 6.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.9"/>
				<path d="M 2.5 9 C 5 8 8.5 8 10.5 9.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" opacity="0.72"/>
				<path d="M 7 2.5 C 6.5 4 6 6 6 9 C 6 11.5 6.5 13.5 7 15.5" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" opacity="0.6"/>
			</svg>
			{SITE_TITLE}
		</a>
	</p>
		<div class="internal-links">
			<HeaderLink href="/" data-track="nav" data-track-location="header" data-track-target="home">Home</HeaderLink>
			<HeaderLink href="/blog" data-track="nav" data-track-location="header" data-track-target="blog">Blog</HeaderLink>
			<HeaderLink href="/learn" data-track="nav" data-track-location="header" data-track-target="learn">Learn</HeaderLink>
			<HeaderLink href="/about" data-track="nav" data-track-location="header" data-track-target="about">About</HeaderLink>
			<HeaderLink href="/glossary" data-track="nav" data-track-location="header" data-track-target="glossary">Glossary</HeaderLink>
			<HeaderLink href="/search" aria-label="Search" data-track="nav" data-track-location="header" data-track-target="search">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
			</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1.5em;
		background: var(--color-header-bg);
		border-bottom: 1px solid rgba(201, 169, 110, 0.12);
	}
	.site-title {
		margin: 0;
		font-size: 1em;
	}
	.site-title a,
	.site-title a.active {
		text-decoration: none;
		color: var(--color-nav-text);
		font-family: var(--font-cinzel), serif;
		letter-spacing: 0.08em;
		display: inline-flex;
		align-items: center;
		gap: 0.38em;
	}
	.brand-mark {
		flex-shrink: 0;
		color: var(--color-nav-text);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5em 0;
	}
	nav a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		box-sizing: border-box;
		padding: 0.9em 0.5em;
		color: var(--color-nav-text);
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-size: 0.82em;
		letter-spacing: 0.07em;
		font-family: var(--font-cinzel), serif;
		transition: color 0.2s ease;
	}
	nav a.active {
		border-bottom-color: var(--color-nav-hover);
		color: var(--color-nav-hover);
	}
	nav a:hover {
		color: var(--color-nav-hover);
	}

	/* Tablet: tighten horizontal padding */
	@media (max-width: 720px) {
		header {
			padding: 0 1em;
		}
	}

	/* Phone: compact brand row + three-column link grid */
	@media (max-width: 600px) {
		header {
			padding: 0;
		}
		nav {
			flex-direction: column;
			align-items: center;
			gap: 0;
			padding: 0.5em 1em 0;
		}
		.site-title {
			font-size: 0.95em;
		}
		.site-title a {
			padding: 0 0 0.4em;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		/* 3-column grid: Home/Blog/Learn row 1, About/Glossary/Search row 2.
		   No orphaned icon; every cell has an equal share of the row width. */
		.internal-links {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			width: 100%;
			border-top: 1px solid rgba(201, 169, 110, 0.08);
		}
		.internal-links a {
			padding: 0.9em 0.4em;
			font-size: 0.76em;
			letter-spacing: 0.04em;
		}
	}
</style>
