---
import BrandMark from './BrandMark.astro';
/**
 * Practice — marks the hands-on exercise a lesson ends with.
 *
 * Purely presentational. The curriculum already asks learners to look at their
 * own hands throughout; this makes that layer recognisable as its own thing
 * rather than more prose. No state, no scoring, no JavaScript, no persistence.
 *
 * The exercise itself goes in the default slot, so it stays authored as ordinary
 * MDX. `title` overrides the heading when a lesson's exercise deserves a more
 * specific name than "Practice".
 */
interface Props {
	title?: string;
}

const { title = 'Practice' } = Astro.props;

// Scoped id so the region's accessible name comes from its own visible heading,
// even when a page carries more than one Practice block.
const headingId = `practice-${Math.random().toString(36).slice(2, 9)}`;
---

<section class="practice reveal" aria-labelledby={headingId}>
	<div class="practice-mark"><BrandMark size={30} star={false} /></div>
	<h2 id={headingId} class="practice-heading">{title}</h2>
	<div class="practice-body">
		<slot />
	</div>
</section>

<style>
	.practice {
		position: relative;
		margin: 3em 0;
		padding: 1.8em 1.9em 1.7em;
		border: 1px solid var(--hairline-strong);
		border-radius: 4px;
		background:
			radial-gradient(ellipse 60% 80% at 0% 0%, rgba(201, 169, 110, 0.1), transparent 70%),
			linear-gradient(180deg, rgba(122, 72, 201, 0.06), transparent 60%),
			var(--color-bg-elev);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
		isolation: isolate;
	}
	.practice::before {
		content: '';
		position: absolute;
		top: -1px;
		left: 12%;
		right: 12%;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--accent-light), transparent);
	}
	.practice-mark {
		position: absolute;
		top: 1.4em;
		right: 1.5em;
		line-height: 0;
		color: var(--accent);
		filter: drop-shadow(0 0 8px rgba(201, 169, 110, 0.5));
		opacity: 0.85;
	}
	.practice-heading {
		font-size: 0.8em;
		letter-spacing: 0.26em;
		text-transform: uppercase;
		color: var(--accent-light);
		margin: 0 0 0.9em 0;
		padding-top: 0;
		text-shadow: 0 0 20px rgba(201, 169, 110, 0.3);
	}
	.practice-heading::before {
		display: none;
	}
	.practice-body :global(> :first-child) {
		margin-top: 0;
	}
	.practice-body :global(> :last-child) {
		margin-bottom: 0;
	}
	.practice-body :global(p) {
		margin-bottom: 1.2em;
	}
	.practice-body :global(ol),
	.practice-body :global(ul) {
		padding-left: 1.3em;
	}
	.practice-body :global(li) {
		margin-bottom: 0.5em;
	}
	.practice-body :global(li::marker) {
		color: var(--accent);
		font-family: var(--font-cinzel), serif;
		font-size: 0.85em;
	}
</style>
