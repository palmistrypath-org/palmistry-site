---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Page not found — ${SITE_TITLE}`}
			description="The page you requested could not be found. Continue with the Palmistry Path lessons, search, or free Starter Guide."
			robots="noindex, follow"
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1" data-pagefind-ignore>
			<section class="not-found" aria-labelledby="not-found-heading">
				<p class="error-code" aria-hidden="true">404</p>
				<h1 id="not-found-heading">This path could not be found</h1>
				<p class="intro">
					The page may have moved or the address may be incomplete. You can return to the
					learning path, search the library, or begin with the free Starter Guide.
				</p>
				<a class="primary-action" href="/learn/">Explore the learning path</a>
				<nav aria-label="Page recovery options">
					<ul>
						<li><a href="/search/">Search Palmistry Path</a></li>
						<li><a href="/guide/">Get the Starter Guide</a></li>
						<li><a href="/">Return home</a></li>
					</ul>
				</nav>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		display: grid;
		place-items: center;
		min-height: min(68vh, 42rem);
	}

	.not-found {
		width: min(100%, 42rem);
		padding: clamp(2rem, 7vw, 4rem);
		border: 1px solid rgba(201, 169, 110, 0.22);
		border-radius: 8px;
		background:
			radial-gradient(circle at 50% 0%, rgba(201, 169, 110, 0.09), transparent 45%),
			var(--color-surface);
		box-sizing: border-box;
		text-align: center;
	}

	.error-code {
		margin: 0 0 0.5rem;
		color: var(--accent);
		font-family: var(--font-cinzel), serif;
		font-size: 0.75rem;
		letter-spacing: 0.35em;
	}

	h1 {
		font-size: clamp(1.75rem, 7vw, 2.8rem);
	}

	.intro {
		max-width: 34rem;
		margin: 1rem auto 1.75rem;
		color: var(--color-text-muted);
		font-size: 0.95rem;
		line-height: 1.8;
	}

	.primary-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0.65rem 1.25rem;
		border-radius: 4px;
		background: var(--accent);
		color: var(--color-bg);
		font-family: var(--font-cinzel), serif;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.primary-action:hover {
		background: var(--accent-light);
		color: var(--color-bg);
		text-decoration: none;
	}

	nav {
		margin-top: 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(201, 169, 110, 0.16);
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-size: 0.82rem;
	}

	@media (max-width: 520px) {
		main {
			min-height: auto;
			padding-block: 2rem;
		}

		.not-found {
			padding: 2rem 1.25rem;
		}

		ul {
			flex-direction: column;
			align-items: center;
		}
	}
</style>
