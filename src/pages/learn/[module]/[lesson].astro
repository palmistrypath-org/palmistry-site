---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import LessonFooter from '../../../components/LessonFooter.astro';
import LessonPath from '../../../components/LessonPath.astro';
import { MODULES, SITE_TITLE } from '../../../consts';

interface ModuleLessonStep {
	href: string;
	title: string;
	order: number;
}

interface LessonLink {
	href: string;
	title: string;
	description?: string;
}

interface Props {
	lesson: CollectionEntry<'lessons'>;
	moduleTitle: string;
	positionInModule: number;
	totalInModule: number;
	prevLesson: LessonLink | null;
	nextLesson: LessonLink | null;
	moduleLessons: ModuleLessonStep[];
}

export async function getStaticPaths() {
	const allLessons = await getCollection('lessons');

	const sorted = [...allLessons].sort((a, b) => {
		const modA = MODULES.findIndex((m) => m.slug === a.data.module);
		const modB = MODULES.findIndex((m) => m.slug === b.data.module);
		if (modA !== modB) return modA - modB;
		return a.data.order - b.data.order;
	});

	function toLessonHref(l: CollectionEntry<'lessons'>) {
		const [, ...parts] = l.id.split('/');
		return `/learn/${l.data.module}/${parts.join('/')}`;
	}

	return sorted.map((lesson, i) => {
		const [modulePart, ...slugParts] = lesson.id.split('/');
		const moduleEntries = sorted.filter((l) => l.data.module === lesson.data.module);
		const positionInModule = moduleEntries.findIndex((l) => l.id === lesson.id) + 1;

		const moduleLessons: ModuleLessonStep[] = moduleEntries.map((l) => ({
			href: toLessonHref(l),
			title: l.data.title,
			order: l.data.order,
		}));

		return {
			params: { module: modulePart, lesson: slugParts.join('/') },
			props: {
				lesson,
				moduleTitle: MODULES.find((m) => m.slug === modulePart)?.title ?? modulePart,
				positionInModule,
				totalInModule: moduleEntries.length,
				moduleLessons,
				prevLesson:
					i > 0
						? {
								href: toLessonHref(sorted[i - 1]),
								title: sorted[i - 1].data.title,
							}
						: null,
				nextLesson:
					i < sorted.length - 1
						? {
								href: toLessonHref(sorted[i + 1]),
								title: sorted[i + 1].data.title,
								description: sorted[i + 1].data.description,
							}
						: null,
			},
		};
	});
}

const { lesson, moduleTitle, positionInModule, totalInModule, prevLesson, nextLesson, moduleLessons } =
	Astro.props;
const { Content } = await render(lesson);

const difficultyLabel: Record<string, string> = {
	beginner: 'Beginner',
	intermediate: 'Intermediate',
	advanced: 'Advanced',
};

const MODULE_ART: Record<string, string> = {
	foundations: '/images/home/path-foundations.webp',
	lines: '/images/home/path-lines.webp',
	mounts: '/images/home/path-mounts.webp',
	advanced: '/images/home/path-advanced.webp',
};
const moduleArt = MODULE_ART[lesson.data.module];

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const moduleUrl = `${Astro.site}learn/${lesson.data.module}/`;
const learnUrl = `${Astro.site}learn/`;

const iso8601Duration = `PT${lesson.data.duration}M`;

const learningResourceSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'LearningResource',
	name: lesson.data.title,
	description: lesson.data.description,
	url: canonicalUrl,
	educationalLevel: difficultyLabel[lesson.data.difficulty],
	timeRequired: iso8601Duration,
	isPartOf: {
		'@type': 'Course',
		name: moduleTitle,
		url: moduleUrl,
		provider: {
			'@type': 'Organization',
			name: 'Palmistry Path',
			url: 'https://palmistrypath.com',
		},
	},
});

const breadcrumbSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Learn', item: learnUrl },
		{ '@type': 'ListItem', position: 2, name: moduleTitle, item: moduleUrl },
		{ '@type': 'ListItem', position: 3, name: lesson.data.title, item: canonicalUrl },
	],
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${lesson.data.title} — ${SITE_TITLE}`}
			description={lesson.data.description}
		/>
		<script type="application/ld+json" set:html={learningResourceSchema} />
		<script type="application/ld+json" set:html={breadcrumbSchema} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}
			/* ── Lesson opening: the module's hand hangs in the dark behind the title ── */
			.lesson-opening {
				position: relative;
				isolation: isolate;
				overflow: hidden;
				padding: 2em 1em 0;
			}
			.opening-art {
				position: absolute;
				inset: 0;
				z-index: -1;
				pointer-events: none;
			}
			.opening-art img {
				position: absolute;
				top: 50%;
				left: 50%;
				width: min(640px, 110vw);
				height: auto;
				transform: translate(-50%, -46%);
				opacity: 0.22;
				filter: saturate(0.9);
				mask-image: radial-gradient(ellipse 50% 60% at 50% 50%, #000 30%, transparent 75%);
				-webkit-mask-image: radial-gradient(ellipse 50% 60% at 50% 50%, #000 30%, transparent 75%);
			}
			.opening-art::before {
				content: '';
				position: absolute;
				inset: 0;
				background:
					radial-gradient(ellipse 45% 55% at 50% 45%, rgba(122, 72, 201, 0.2), transparent 70%),
					linear-gradient(180deg, transparent 60%, var(--color-bg) 100%);
			}
			.breadcrumb {
				width: var(--measure);
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 0.5em 1em 0;
				font-family: var(--font-cinzel), serif;
				font-size: 0.6em;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--color-text-muted);
				text-align: center;
			}
			.breadcrumb a {
				color: var(--color-text-muted);
				text-decoration: none;
				transition: color 0.3s var(--ease-out);
			}
			.breadcrumb a:hover {
				color: var(--accent);
			}
			.breadcrumb .crumb-sep {
				opacity: 0.4;
				margin: 0 0.5em;
			}
			.lesson-header {
				width: var(--measure);
				max-width: calc(100% - 2em);
				margin: clamp(2em, 6vh, 4em) auto 0;
				padding: 0 1em;
				text-align: center;
			}
			.lesson-position {
				margin-bottom: 1em;
			}
			.lesson-header h1 {
				margin: 0 0 0.5em;
				font-size: clamp(1.6rem, 5vw, 2.9em);
			}
			.lesson-meta {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.7em;
				font-family: var(--font-cinzel), serif;
				font-size: 0.66em;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--color-text-muted);
				margin-bottom: 2em;
			}
			.lesson-meta .sep {
				opacity: 0.4;
			}
			.difficulty-beginner {
				color: var(--accent);
			}
			.difficulty-intermediate {
				color: var(--accent-light);
			}
			.difficulty-advanced {
				color: var(--color-heading);
			}
			.prose {
				width: var(--measure);
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 0 1em 2em;
				color: var(--color-text);
			}
			/* First paragraph reads as a lede — larger, lit */
			.prose > :global(p:first-of-type) {
				font-size: 1.08em;
				line-height: 1.85;
				color: var(--color-heading);
			}
			.prose > :global(p:first-of-type)::first-letter {
				font-family: var(--font-cinzel), serif;
				font-size: 3.2em;
				line-height: 0.8;
				float: left;
				margin: 0.08em 0.14em 0 0;
				color: var(--accent-light);
				text-shadow: 0 0 24px rgba(201, 169, 110, 0.35);
			}
			.related-article {
				margin-top: 3em;
				padding: 1.25em 1.5em;
				border: 1px solid var(--hairline);
				border-left: 2px solid var(--accent);
				border-radius: 4px;
				background: linear-gradient(90deg, rgba(122, 72, 201, 0.08), transparent 60%);
				font-size: 0.88em;
				color: var(--color-text-muted);
			}
			.related-article p {
				margin: 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1">
			<div class="lesson-opening">
				{moduleArt && (
					<div class="opening-art" aria-hidden="true">
						<img src={moduleArt} alt="" width="640" height="640" loading="eager" decoding="async" />
					</div>
				)}
				<nav class="breadcrumb reveal" aria-label="Breadcrumb">
					<a href="/learn" data-track="nav" data-track-location="lesson-breadcrumb" data-track-target="learn">Learn</a>
					<span class="crumb-sep" aria-hidden="true">›</span>
					<a href={`/learn/${lesson.data.module}`} data-track="nav" data-track-location="lesson-breadcrumb" data-track-target="module">{moduleTitle}</a>
					<span class="crumb-sep" aria-hidden="true">›</span>
					<span>{lesson.data.title}</span>
				</nav>

				<div class="lesson-header">
					<p class="eyebrow lesson-position reveal" style="--reveal-delay: 100ms">
						Lesson {positionInModule} of {totalInModule} · {moduleTitle}
					</p>
					<h1 class="display reveal" style="--reveal-delay: 220ms">{lesson.data.title}</h1>
					<div class="lesson-meta reveal" style="--reveal-delay: 340ms">
						<span class={`difficulty-${lesson.data.difficulty}`}>
							{difficultyLabel[lesson.data.difficulty]}
						</span>
						<span class="sep" aria-hidden="true">·</span>
						<span>~{lesson.data.duration} min</span>
					</div>
					<div class="divider-star reveal reveal--line" style="--reveal-delay: 420ms" aria-hidden="true"></div>
				</div>

				<LessonPath
					steps={moduleLessons}
					currentOrder={positionInModule}
					moduleTitle={moduleTitle}
					moduleSlug={lesson.data.module}
				/>
			</div>

			<article class="prose">
				<Content />
				{
					lesson.data.relatedArticle && (
						<aside class="related-article">
							<p>
								Want more depth?{' '}
								<a href={`${lesson.data.relatedArticle}/`}
									data-track="link" data-track-location="lesson-body" data-track-target="blog">Read the full article →</a>
							</p>
						</aside>
					)
				}
			</article>
		</main>

		<LessonFooter prevLesson={prevLesson} nextLesson={nextLesson} />

		<Footer />
	</body>
</html>
