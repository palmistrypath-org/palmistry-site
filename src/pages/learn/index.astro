---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { MODULES, SITE_TITLE } from '../../consts';

const MODULE_ART: Record<string, string> = {
	foundations: '/images/home/path-foundations.webp',
	lines: '/images/home/path-lines.webp',
	mounts: '/images/home/path-mounts.webp',
	advanced: '/images/home/path-advanced.webp',
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Learn Palmistry — ${SITE_TITLE}`}
			description="A structured learning path through palmistry — from foundational concepts to advanced interpretation."
		/>
		<style>
			main {
				width: 100%;
				max-width: 100%;
				padding: 0;
				margin: 0;
			}
			.page-header {
				position: relative;
				text-align: center;
				padding: clamp(3.5em, 9vh, 6em) 1.5em clamp(2.5em, 6vh, 4em);
				isolation: isolate;
				overflow: hidden;
			}
			.page-header::before {
				content: '';
				position: absolute;
				inset: 0;
				z-index: -1;
				background:
					radial-gradient(ellipse 50% 60% at 50% 0%, rgba(122, 72, 201, 0.22), transparent 70%),
					radial-gradient(ellipse 40% 30% at 50% 100%, rgba(201, 169, 110, 0.05), transparent 70%),
					url('/images/home/haze-nebula.webp') center / cover;
			}
			.page-header::after {
				content: '';
				position: absolute;
				inset: 0;
				z-index: -1;
				background: linear-gradient(180deg, rgba(7, 5, 13, 0.3), rgba(7, 5, 13, 0.6) 60%, var(--color-bg));
			}
			.page-header h1 {
				font-size: clamp(1.7rem, 5.5vw, 3.2em);
				letter-spacing: 0.1em;
				margin-bottom: 0.5em;
			}
			.page-header .intro {
				font-size: 0.95em;
				color: var(--color-text-muted);
				max-width: 520px;
				margin: 0 auto;
				line-height: 1.8;
			}
			.divider-star {
				margin: 0 auto clamp(2.5em, 6vh, 4em);
			}
			.module-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.4rem;
				list-style: none;
				margin: 0 auto;
				padding: 0 1em;
				width: var(--wide);
				max-width: calc(100% - 3em);
			}
			.module-card {
				display: grid;
				grid-template-columns: 180px 1fr;
				height: 100%;
				overflow: hidden;
				box-sizing: border-box;
				background:
					linear-gradient(90deg, rgba(122, 72, 201, 0.1) 0%, rgba(7, 5, 13, 0) 60%),
					var(--color-bg-elev);
			}
			.module-art {
				position: relative;
				overflow: hidden;
				background: radial-gradient(ellipse 60% 55% at 50% 50%, rgba(122, 72, 201, 0.18), transparent 70%);
			}
			.module-art img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				transform: scale(1.04);
				transition: transform 1.2s var(--ease-out), filter 1.2s var(--ease-out);
			}
			.module-art::after {
				content: '';
				position: absolute;
				inset: 0;
				background: linear-gradient(90deg, transparent 45%, var(--color-bg-elev) 100%);
			}
			.module-card:hover .module-art img {
				transform: scale(1.1);
				filter: brightness(1.1);
			}
			.module-body {
				padding: 1.5rem 1.6rem 1.5rem 0.8rem;
				display: flex;
				flex-direction: column;
			}
			.module-eyebrow {
				display: flex;
				gap: 0.8em;
				align-items: baseline;
				font-family: var(--font-cinzel), serif;
				font-size: 0.58em;
				letter-spacing: 0.24em;
				text-transform: uppercase;
				color: var(--accent);
				margin-bottom: 0.7rem;
			}
			.module-eyebrow .sep {
				opacity: 0.4;
			}
			.module-eyebrow .difficulty {
				color: var(--color-text-muted);
			}
			.module-title {
				margin: 0 0 0.5rem;
				font-family: var(--font-cinzel), serif;
				font-size: 1.15em;
				color: var(--accent-light);
				line-height: 1.3;
				text-shadow: 0 0 24px rgba(201, 169, 110, 0.2);
			}
			.module-description {
				margin: 0;
				color: var(--color-text-muted);
				font-size: 0.8em;
				line-height: 1.65;
				flex: 1;
			}
			.module-go {
				margin-top: 1.1em;
				font-family: var(--font-cinzel), serif;
				font-size: 0.58em;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--accent);
				opacity: 0.7;
				transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out);
			}
			.module-card:hover .module-go {
				opacity: 1;
				transform: translateX(3px);
			}
			.guide-aside {
				width: var(--measure);
				max-width: calc(100% - 3em);
				margin: clamp(3em, 7vh, 5em) auto clamp(4em, 8vh, 6em);
				padding: 1.75em 1em 0;
				border-top: 1px solid var(--hairline);
				text-align: center;
			}
			.guide-aside p {
				font-size: 0.85em;
				color: var(--color-text-muted);
				max-width: 520px;
				margin: 0 auto;
				line-height: 1.75;
			}
			@media (max-width: 760px) {
				.module-grid {
					grid-template-columns: 1fr;
				}
			}
			@media (max-width: 480px) {
				.module-card {
					grid-template-columns: 1fr;
				}
				.module-art {
					aspect-ratio: 16 / 9;
				}
				.module-art::after {
					background: linear-gradient(180deg, transparent 40%, var(--color-bg-elev) 100%);
				}
				.module-body {
					padding: 0 1.4rem 1.4rem;
					margin-top: -1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1">
			<section class="page-header">
				<p class="eyebrow reveal">The curriculum</p>
				<h1 class="display reveal" style="--reveal-delay: 140ms">Learn Palmistry</h1>
				<p class="intro reveal" style="--reveal-delay: 280ms">A structured path from first principles to nuanced interpretation — twenty-five lessons across four modules.</p>
			</section>
			<div class="divider-star reveal reveal--line" aria-hidden="true"></div>
			<ul class="module-grid">
				{
					MODULES.map((mod, i) => (
						<li class="reveal" style={`--reveal-delay: ${i * 120}ms`}>
							<a href={`/learn/${mod.slug}`} class="module-card card">
								<span class="module-art" aria-hidden="true">
									<img src={MODULE_ART[mod.slug]} alt="" width="640" height="640" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
								</span>
								<span class="module-body">
									<span class="module-eyebrow">
										<span>Module {String(i + 1).padStart(2, '0')}</span>
										<span class="sep" aria-hidden="true">·</span>
										<span class="difficulty">{mod.difficulty}</span>
									</span>
									<h2 class="module-title">{mod.title}</h2>
									<p class="module-description">{mod.description}</p>
									<span class="module-go">Enter the module <span aria-hidden="true">→</span></span>
								</span>
							</a>
						</li>
					))
				}
			</ul>
			<aside class="guide-aside reveal">
				<p>New to palmistry? The <a href="/guide/" data-cta="guide">free Starter Guide</a> covers the major lines, mounts, and hand shapes — a useful reference while you work through the lessons.</p>
			</aside>
		</main>
		<Footer />
	</body>
</html>
