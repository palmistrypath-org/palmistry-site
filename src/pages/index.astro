---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { MODULES, SITE_TITLE } from '../consts';

const VISUAL_ROOT = '/images/editorial-mystic/homepage';
const MODULE_ART: Record<string, string> = {
	foundations: `${VISUAL_ROOT}/path-beginner-1x1.webp`,
	lines: `${VISUAL_ROOT}/path-major-lines-1x1.webp`,
	mounts: `${VISUAL_ROOT}/path-mounts-1x1.webp`,
	advanced: `${VISUAL_ROOT}/path-deeper-lessons-1x1.webp`,
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Learn Palmistry — ${SITE_TITLE}`}
			description="A structured, grounded guide to palm reading across Indian, Chinese, and Western traditions. Learn the lines, mounts, and hand shapes without fortune-telling claims."
			image="/images/editorial-mystic/homepage/hero-final-desktop-16x9.webp"
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1">
			<section class="hero">
				<picture class="hero-picture" aria-hidden="true">
					<source media="(max-width: 600px)" srcset="/images/editorial-mystic/homepage/hero-final-mobile-9x16.webp" />
					<img src="/images/editorial-mystic/homepage/hero-final-desktop-16x9.webp" alt="" width="1920" height="1072" loading="eager" decoding="async" fetchpriority="high" />
				</picture>
				<div class="hero-copy">
					<p class="eyebrow">A grounded path into palmistry</p>
					<h1>Learn palmistry as a structured practice</h1>
					<p class="hero-sub">Study the lines, mounts, hand shapes, and traditions of palm reading through clear lessons built for careful observation — not prediction.</p>
					<div class="hero-ctas">
						<a href="/learn/foundations/01-what-palmistry-is" class="btn-primary" data-track="cta" data-track-location="homepage-hero" data-track-target="learn">Start the Beginner Path</a>
						<a href="/guide" class="btn-secondary" data-track="cta" data-track-location="homepage-hero" data-track-target="guide">Get the Free Starter Guide</a>
					</div>
				</div>
			</section>

			<section class="intro section-narrow" aria-labelledby="intro-heading">
				<p class="eyebrow" id="intro-heading">Read the lines. Discover the path.</p>
				<p class="intro-lede">Palmistry Path turns a broad traditional subject into a calm, progressive learning sequence. Start with the hand as a whole, learn its major lines and mounts, then practice combining what you observe.</p>
				<ul class="trust-pillars" aria-label="Site principles">
					<li>No prediction claims</li><li>Tradition-aware</li><li>Beginner-friendly</li><li>Built for observation</li>
				</ul>
			</section>

			<section class="path-section" aria-labelledby="path-heading">
				<div class="section-heading"><p class="eyebrow">Four progressive modules</p><h2 id="path-heading">Follow the beginner path</h2></div>
				<ol class="path-steps" role="list">
					{MODULES.map((mod, i) => (
						<li><a href={`/learn/${mod.slug}`} class="path-step" data-track="nav" data-track-location="homepage-path" data-track-target={mod.slug}>
							<img src={MODULE_ART[mod.slug]} alt="" aria-hidden="true" width="800" height="800" loading="lazy" decoding="async" />
							<span class="step-content"><span class="step-num">0{i + 1}</span><span class="step-title">{mod.title}</span><span class="step-difficulty">{mod.difficulty}</span><span class="step-desc">{mod.description}</span></span>
						</a></li>
					))}
				</ol>
			</section>

			<section class="guide-cta" aria-labelledby="guide-heading">
				<img src="/images/editorial-mystic/homepage/cta-quick-start-guide-1x1.webp" alt="A refined stack of Palmistry Path guide pages" width="800" height="800" loading="lazy" decoding="async" />
				<div><p class="eyebrow">Free quick start guide</p><h2 id="guide-heading">Keep the essentials beside you</h2><p>Use a concise reference to the major lines, mounts, and hand shapes while you work through the lessons. It also includes a printable observation sheet for practice.</p><a href="/guide" class="btn-primary" data-track="cta" data-track-location="homepage-guide-cta" data-track-target="guide">Get the Starter Guide</a></div>
			</section>

			<div class="discovery-grid">
				<section aria-labelledby="starter-heading"><p class="eyebrow">Essential reading</p><h2 id="starter-heading">A place to start</h2>
					<ul class="text-link-list" role="list">
						<li><a href="/blog/beginner/what-do-palm-lines-mean">What do palm lines mean?</a></li><li><a href="/blog/beginner/which-hand-to-read-palmistry">Which hand to read</a></li><li><a href="/blog/beginner/how-to-read-a-palm">How to read a palm</a></li><li><a href="/blog/beginner/palmistry-chart-for-beginners">Palmistry chart for beginners</a></li><li><a href="/blog/beginner/hand-shapes">Hand shapes in palmistry</a></li><li><a href="/blog/beginner/palmistry-vs-astrology">Palmistry vs. astrology</a></li>
					</ul>
				</section>
				<section aria-labelledby="hubs-heading"><p class="eyebrow">Explore the library</p><h2 id="hubs-heading">Browse by topic</h2>
					<ul class="hub-list" role="list"><li><a href="/blog/beginner/major-lines-overview/">Lines</a></li><li><a href="/blog/beginner/hand-shapes/">Hand Shape</a></li><li><a href="/blog/beginner/mounts-overview/">Mounts</a></li><li><a href="/blog/beginner/western-palmistry-basics/">Traditions</a></li><li><a href="/blog/beginner/crosses-stars-palmistry/">Markings</a></li><li><a href="/blog/beginner/marriage-relationship-lines/">Relationships</a></li></ul>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main { width: 100%; max-width: none; padding: 0; }
	.eyebrow { margin: 0 0 0.75rem; font-family: var(--font-cinzel), serif; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-teal-dark); }
	.hero { position: relative; min-height: clamp(34rem, 67vw, 48rem); display: flex; align-items: center; overflow: hidden; border-bottom: 1px solid var(--color-border); background: var(--color-ivory); }
	.hero-picture, .hero-picture img { position: absolute; inset: 0; width: 100%; height: 100%; }
	.hero-picture img { object-fit: cover; object-position: center; }
	.hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(248, 243, 233, 0.99) 4%, rgba(248, 243, 233, 0.93) 34%, rgba(248, 243, 233, 0.22) 69%, rgba(248, 243, 233, 0.04)); }
	.hero-copy { position: relative; z-index: 1; width: min(42rem, calc(100% - 3rem)); margin-left: max(1.5rem, calc((100% - 1180px) / 2)); padding: 5rem 0; }
	.hero h1 { max-width: 40rem; margin: 0 0 1rem; font-size: clamp(2.25rem, 5.7vw, 4.6rem); letter-spacing: -0.015em; }
	.hero-sub { max-width: 37rem; margin: 0 0 2rem; color: var(--color-text-secondary); font-size: clamp(1rem, 2vw, 1.16rem); line-height: 1.7; }
	.hero-ctas { display: flex; gap: 0.85rem; flex-wrap: wrap; }
	.btn-primary, .btn-secondary { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; box-sizing: border-box; padding: 0.8rem 1.3rem; border-radius: 3px; font-family: var(--font-cinzel), serif; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease; }
	.btn-primary { background: var(--color-cta-bg); color: var(--color-cta-text); border: 1px solid var(--color-cta-bg); }
	.btn-primary:hover { background: var(--color-cta-hover); color: var(--color-cta-text); transform: translateY(-1px); }
	.btn-secondary { color: var(--color-teal-deep); border: 1px solid var(--color-teal); background: rgba(255, 250, 241, 0.72); }
	.btn-secondary:hover { color: var(--color-teal-deep); border-color: var(--color-teal-deep); background: var(--color-surface); }
	.section-narrow { width: min(760px, calc(100% - 3rem)); margin: 0 auto; }
	.intro { padding: clamp(4.5rem, 8vw, 7rem) 0; text-align: center; }
	.intro-lede { margin: 0; font-size: clamp(1.08rem, 2.1vw, 1.35rem); line-height: 1.75; color: var(--color-text-secondary); }
	.trust-pillars { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.55rem; list-style: none; padding: 0; margin: 2rem 0 0; }
	.trust-pillars li { padding: 0.42rem 0.72rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-text-secondary); font-size: 0.76rem; }
	.path-section { width: min(1180px, calc(100% - 3rem)); margin: 0 auto; padding: 1rem 0 clamp(5rem, 9vw, 8rem); }
	.section-heading { text-align: center; margin-bottom: 2rem; }
	.section-heading h2, .guide-cta h2, .discovery-grid h2 { margin: 0; }
	.path-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; list-style: none; margin: 0; padding: 0; }
	.path-step { display: flex; flex-direction: column; height: 100%; overflow: hidden; background: var(--color-surface); border: 1px solid var(--color-border); text-decoration: none; box-shadow: 0 8px 24px rgba(63, 51, 35, 0.045); transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease; }
	.path-step:hover { transform: translateY(-3px); border-color: var(--color-border-strong); box-shadow: var(--box-shadow); }
	.path-step img { width: 100%; aspect-ratio: 1; object-fit: cover; border-bottom: 1px solid var(--color-border); }
	.step-content { display: flex; flex: 1; flex-direction: column; padding: 1.25rem; }
	.step-num { color: var(--color-gold-ink); font-family: var(--font-cinzel), serif; font-size: 0.65rem; letter-spacing: 0.14em; }
	.step-title { color: var(--color-heading); font-family: var(--font-cinzel), serif; font-size: 1rem; margin-top: 0.55rem; }
	.step-difficulty { color: var(--color-teal-dark); font-family: var(--font-cinzel), serif; font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; margin: 0.25rem 0 0.8rem; }
	.step-desc { color: var(--color-text-secondary); font-size: 0.76rem; line-height: 1.55; }
	.guide-cta { width: min(1060px, calc(100% - 3rem)); margin: 0 auto clamp(5rem, 9vw, 8rem); display: grid; grid-template-columns: minmax(16rem, 0.78fr) 1.22fr; align-items: center; gap: clamp(2rem, 6vw, 5rem); padding: clamp(2rem, 5vw, 4rem); box-sizing: border-box; background: var(--color-ivory); border: 1px solid var(--color-border); }
	.guide-cta img { width: 100%; aspect-ratio: 1; object-fit: cover; box-shadow: var(--box-shadow); }
	.guide-cta p:not(.eyebrow) { color: var(--color-text-secondary); font-size: 0.93rem; line-height: 1.7; }
	.discovery-grid { width: min(1060px, calc(100% - 3rem)); margin: 0 auto; padding-bottom: clamp(5rem, 9vw, 8rem); display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 5rem); }
	.text-link-list, .hub-list { list-style: none; padding: 0; margin: 1.3rem 0 0; }
	.text-link-list li { border-top: 1px solid var(--color-border); }
	.text-link-list li:last-child { border-bottom: 1px solid var(--color-border); }
	.text-link-list a { display: block; padding: 0.68rem 0; color: var(--color-text-secondary); text-decoration: none; font-size: 0.86rem; }
	.text-link-list a::after { content: ' →'; color: var(--color-teal-dark); }
	.hub-list { display: flex; gap: 0.55rem; flex-wrap: wrap; }
	.hub-list a { display: inline-flex; padding: 0.55rem 0.8rem; border: 1px solid var(--color-border-strong); color: var(--color-teal-deep); font-family: var(--font-cinzel), serif; font-size: 0.64rem; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; }
	.hub-list a:hover { background: var(--color-surface-muted); }
	@media (max-width: 900px) { .path-steps { grid-template-columns: repeat(2, 1fr); } }
	@media (max-width: 700px) {
		.hero { min-height: 42rem; align-items: end; }
		.hero-picture img { object-position: center 27%; }
		.hero::after { background: linear-gradient(180deg, rgba(248, 243, 233, 0.02) 16%, rgba(248, 243, 233, 0.78) 48%, rgba(248, 243, 233, 0.99) 66%); }
		.hero-copy { width: calc(100% - 2rem); margin: 0 auto; padding: 14rem 0 2.4rem; }
		.hero h1 { font-size: clamp(2rem, 10.5vw, 3.25rem); }
		.guide-cta, .discovery-grid { grid-template-columns: 1fr; }
		.guide-cta img { max-width: 26rem; margin: 0 auto; }
	}
	@media (max-width: 520px) {
		.path-steps { grid-template-columns: 1fr; }
		.path-step { display: grid; grid-template-columns: 38% 62%; }
		.path-step img { height: 100%; min-height: 12rem; border: 0; border-right: 1px solid var(--color-border); }
		.hero-ctas { align-items: stretch; flex-direction: column; }
		.btn-primary, .btn-secondary { width: 100%; }
	}
</style>
