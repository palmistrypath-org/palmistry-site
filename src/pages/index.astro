---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { MODULES, SITE_TITLE } from '../consts';

const MODULE_ART: Record<string, string> = {
	foundations: '/images/home/path-foundations.webp',
	lines: '/images/home/path-lines.webp',
	mounts: '/images/home/path-mounts.webp',
	advanced: '/images/home/path-advanced.webp',
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Learn Palmistry — ${SITE_TITLE}`}
			description="A structured, grounded guide to palm reading across Indian, Chinese, and Western traditions. Learn the lines, mounts, and hand shapes without fortune-telling claims."
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1">
			<!-- ── Hero ──────────────────────────────────────────────── -->
			<section class="hero">
				<div class="hero-image-wrap">
					<img
						src="/images/home/hero-palm-map.webp"
						alt="Illustrated palm map with highlighted palmistry lines and mount regions"
						class="hero-image"
						width="1672"
						height="941"
						loading="eager"
						decoding="async"
						fetchpriority="high"
					/>
				</div>
				<h1>Learn palmistry as a structured practice</h1>
				<p class="hero-sub">
					A grounded guide to the lines, mounts, hand shapes, and traditions of palm reading —
					without fortune-telling claims.
				</p>
				<div class="hero-ctas">
					<a href="/learn/foundations/01-what-palmistry-is" class="btn-primary"
						data-track="cta" data-track-location="homepage-hero" data-track-target="learn"
						>Start the Beginner Path</a
					>
					<a href="/guide" class="btn-secondary"
						data-track="cta" data-track-location="homepage-hero" data-track-target="guide"
						>Get the Free Starter Guide</a>
				</div>
			</section>

			<div class="divider" aria-hidden="true">✦ · ✦ · ✦</div>

			<!-- ── Intro ──────────────────────────────────────────────── -->
			<section class="intro">
				<p>
					The human hand carries a map — a record of structure, temperament, and tendency etched
					into the palm and fingers. Palmistry is the study of that map: its lines, mounts, and
					shapes, and what they have meant to practitioners across centuries and cultures.
				</p>
				<p>
					Content here draws from three major traditions: Indian (Hasta Samudrika Shastra), Chinese
					palmistry, and Western palmistry as systematised by Cheiro. Where traditions agree, the
					consensus is noted. Where they diverge, both views are presented honestly rather than one
					being quietly discarded. No prior knowledge is assumed, and no claims are made about
					predicting the future.
				</p>
			</section>

			<div class="divider" aria-hidden="true">✦ · ✦ · ✦</div>

			<!-- ── How the path works ─────────────────────────────────── -->
			<section class="path-section">
				<h2 class="section-eyebrow">How the path works</h2>
				<ol class="path-steps" role="list">
					{
						MODULES.map((mod, i) => (
							<li>
								<a href={`/learn/${mod.slug}`} class="path-step"
									data-track="nav" data-track-location="homepage-path" data-track-target={mod.slug}>
									{MODULE_ART[mod.slug] && (
										<img
											src={MODULE_ART[mod.slug]}
											alt=""
											aria-hidden="true"
											class="path-card-art"
											width="640"
											height="640"
											loading="lazy"
											decoding="async"
										/>
									)}
									<span class="step-content">
										<span class="step-num">{i + 1}</span>
										<span class="step-title">{mod.title}</span>
										<span class="step-difficulty">{mod.difficulty}</span>
										<span class="step-desc">{mod.description}</span>
									</span>
								</a>
							</li>
						))
					}
				</ol>
			</section>

			<div class="divider" aria-hidden="true">✦ · ✦ · ✦</div>

			<!-- ── Trust pillars ──────────────────────────────────────── -->
			<section class="trust-section" aria-label="Site principles">
				<ul class="trust-pillars" role="list">
					<li>
						<span class="pillar-mark" aria-hidden="true">✦</span>
						<span>No prediction claims</span>
					</li>
					<li>
						<span class="pillar-mark" aria-hidden="true">✦</span>
						<span>Tradition-aware</span>
					</li>
					<li>
						<span class="pillar-mark" aria-hidden="true">✦</span>
						<span>Beginner-friendly</span>
					</li>
					<li>
						<span class="pillar-mark" aria-hidden="true">✦</span>
						<span>Built for careful observation</span>
					</li>
				</ul>
			</section>

			<div class="divider" aria-hidden="true">✦ · ✦ · ✦</div>

			<!-- ── Starter articles ───────────────────────────────────── -->
			<section class="starter-section" aria-labelledby="starter-heading">
				<h2 class="section-eyebrow" id="starter-heading">A place to start</h2>
				<ul class="starter-links" role="list">
					<li><a href="/blog/beginner/what-do-palm-lines-mean" class="starter-link" data-track="link" data-track-location="homepage-starter" data-track-target="blog">What do palm lines mean?</a></li>
					<li><a href="/blog/beginner/which-hand-to-read-palmistry" class="starter-link" data-track="link" data-track-location="homepage-starter" data-track-target="blog">Which hand to read</a></li>
					<li><a href="/blog/beginner/how-to-read-a-palm" class="starter-link" data-track="link" data-track-location="homepage-starter" data-track-target="blog">How to read a palm</a></li>
					<li><a href="/blog/beginner/palmistry-chart-for-beginners" class="starter-link" data-track="link" data-track-location="homepage-starter" data-track-target="blog">Palmistry chart for beginners</a></li>
					<li><a href="/blog/beginner/hand-shapes" class="starter-link" data-track="link" data-track-location="homepage-starter" data-track-target="blog">Hand shapes in palmistry</a></li>
					<li><a href="/blog/beginner/palmistry-vs-astrology" class="starter-link" data-track="link" data-track-location="homepage-starter" data-track-target="blog">Palmistry vs. astrology</a></li>
				</ul>
			</section>

			<div class="divider" aria-hidden="true">✦ · ✦ · ✦</div>

			<!-- ── Topic hubs ─────────────────────────────────────────── -->
			<section class="hubs-section" aria-labelledby="hubs-heading">
				<h2 class="section-eyebrow" id="hubs-heading">Browse by topic</h2>
				<ul class="hub-list" role="list">
					<li><a href="/blog/beginner/major-lines-overview/" class="hub-link" data-track="link" data-track-location="homepage-hubs" data-track-target="blog">Lines</a></li>
					<li><a href="/blog/beginner/hand-shapes/" class="hub-link" data-track="link" data-track-location="homepage-hubs" data-track-target="blog">Hand Shape</a></li>
					<li><a href="/blog/beginner/mounts-overview/" class="hub-link" data-track="link" data-track-location="homepage-hubs" data-track-target="blog">Mounts</a></li>
					<li><a href="/blog/beginner/western-palmistry-basics/" class="hub-link" data-track="link" data-track-location="homepage-hubs" data-track-target="blog">Traditions</a></li>
					<li><a href="/blog/beginner/crosses-stars-palmistry/" class="hub-link" data-track="link" data-track-location="homepage-hubs" data-track-target="blog">Markings</a></li>
					<li><a href="/blog/beginner/marriage-relationship-lines/" class="hub-link" data-track="link" data-track-location="homepage-hubs" data-track-target="blog">Relationships</a></li>
				</ul>
			</section>

			<div class="divider" aria-hidden="true">✦ · ✦ · ✦</div>

			<!-- ── Guide CTA ───────────────────────────────────────────── -->
			<section class="guide-cta">
				<h2 class="guide-cta-heading">Start with the free guide</h2>
				<p class="guide-cta-sub">
					The Palmistry Starter Guide covers the major lines, mounts, hand shapes, and includes a
					printable observation sheet. A useful reference from your first lesson.
				</p>
				<a href="/guide" class="btn-primary" data-track="cta" data-track-location="homepage-guide-cta" data-track-target="guide">Get the Starter Guide</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	main {
		width: 100%;
		max-width: 100%;
		padding: 0;
		margin: 0;
	}

	/* ── Hero ─────────────────────────────────────────────────── */
	.hero {
		position: relative;
		overflow: hidden;
		text-align: center;
		padding: 3.5em 1.5em 3em;
		min-height: 340px;
		background: radial-gradient(
			ellipse 70% 60% at 50% 38%,
			rgba(201, 169, 110, 0.09) 0%,
			transparent 70%
		);
	}
	.hero-image-wrap {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}
	/* Gradient overlay: solid bg on left for text legibility, fades to semi-transparent on right */
	.hero-image-wrap::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to right,
			var(--color-bg) 0%,
			rgba(13, 10, 26, 0.88) 22%,
			rgba(13, 10, 26, 0.62) 55%,
			rgba(13, 10, 26, 0.72) 100%
		);
	}
	.hero-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* Hand is on the right side of the image — keep it visible */
		object-position: 65% center;
		filter: brightness(0.55) saturate(0.78);
	}
	/* Text floats above the image layer */
	.hero h1,
	.hero-sub,
	.hero-ctas {
		position: relative;
		z-index: 1;
	}
	.hero h1 {
		font-size: clamp(1.5rem, 5vw, 3em);
		letter-spacing: 0.06em;
		color: var(--accent);
		text-shadow:
			0 0 80px rgba(201, 169, 110, 0.2),
			0 2px 8px rgba(0, 0, 0, 0.7);
		margin: 0 auto 0.5em;
		max-width: 760px;
	}
	.hero-sub {
		font-size: 0.9em;
		color: var(--color-text-muted);
		max-width: 540px;
		margin: 0 auto 2em;
		line-height: 1.75;
	}
	.hero-ctas {
		display: flex;
		gap: 1em;
		justify-content: center;
		flex-wrap: wrap;
	}

	/* ── Buttons ──────────────────────────────────────────────── */
	.btn-primary {
		display: inline-block;
		background: var(--accent);
		color: var(--color-bg);
		font-family: var(--font-cinzel), serif;
		font-size: 0.68em;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		padding: 0.9em 1.8em;
		border-radius: 4px;
		transition:
			background 0.2s ease,
			box-shadow 0.2s ease;
	}
	.btn-primary:hover {
		background: var(--accent-light);
		color: var(--color-bg);
		box-shadow: 0 2px 14px rgba(201, 169, 110, 0.2);
		text-decoration: none;
	}
	.btn-secondary {
		display: inline-block;
		background: transparent;
		color: var(--accent);
		font-family: var(--font-cinzel), serif;
		font-size: 0.68em;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		padding: 0.9em 1.8em;
		border-radius: 4px;
		border: 1px solid rgba(201, 169, 110, 0.4);
		transition:
			border-color 0.2s ease,
			background 0.2s ease,
			color 0.2s ease;
	}
	.btn-secondary:hover {
		border-color: var(--accent);
		background: rgba(201, 169, 110, 0.06);
		color: var(--accent-light);
		text-decoration: none;
	}

	/* ── Divider ──────────────────────────────────────────────── */
	.divider {
		text-align: center;
		color: var(--accent);
		letter-spacing: 0.5em;
		font-size: 0.6em;
		opacity: 0.5;
		padding: 2.5em 0;
	}

	/* ── Intro ────────────────────────────────────────────────── */
	.intro {
		width: 720px;
		max-width: calc(100% - 3em);
		margin: 0 auto;
		padding: 0 1em;
	}
	.intro p {
		line-height: 1.9;
	}

	/* ── Path section ─────────────────────────────────────────── */
	.path-section {
		width: 960px;
		max-width: calc(100% - 3em);
		margin: 0 auto;
		padding: 0 1em;
	}
	.section-eyebrow {
		font-family: var(--font-cinzel), serif;
		font-size: 0.62em;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		opacity: 0.6;
		text-align: center;
		margin: 0 0 2em;
	}
	.path-steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.25rem;
	}
	.path-step {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		border: 1px solid rgba(201, 169, 110, 0.2);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.02);
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			background 0.2s ease;
		box-sizing: border-box;
		height: 100%;
	}
	.path-step:hover {
		border-color: rgba(201, 169, 110, 0.5);
		background: rgba(201, 169, 110, 0.04);
		text-decoration: none;
	}
	.path-step:hover .path-card-art {
		opacity: 0.44;
	}
	/* Dark gradient overlay — sits above the artwork, below the text */
	.path-step::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to right,
			rgba(13, 10, 26, 0.78) 0%,
			rgba(13, 10, 26, 0.48) 52%,
			rgba(13, 10, 26, 0.12) 100%
		);
		z-index: 1;
		pointer-events: none;
	}
	.path-card-art {
		position: absolute;
		right: -10%;
		top: 50%;
		transform: translateY(-50%);
		height: 115%;
		width: auto;
		max-width: none; /* prevent browser clamping width and squishing aspect ratio */
		opacity: 0.34;
		filter: saturate(0.95) brightness(0.95);
		pointer-events: none;
		z-index: 0;
		transition: opacity 0.2s ease;
	}
	.step-content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
	}
	.step-num {
		display: block;
		font-family: var(--font-cinzel), serif;
		font-size: 0.62em;
		letter-spacing: 0.18em;
		color: var(--accent);
		opacity: 0.65;
		margin-bottom: 0.5em;
	}
	.step-title {
		display: block;
		font-family: var(--font-cinzel), serif;
		font-size: 0.9em;
		color: var(--color-heading);
		margin-bottom: 0.3em;
		line-height: 1.3;
	}
	.step-difficulty {
		display: block;
		font-family: var(--font-cinzel), serif;
		font-size: 0.58em;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
		opacity: 0.55;
		margin-bottom: 0.8em;
	}
	.step-desc {
		display: block;
		font-size: 0.75em;
		color: var(--color-text-muted);
		line-height: 1.65;
		opacity: 0.85;
	}

	/* ── Trust pillars ────────────────────────────────────────── */
	.trust-section {
		width: 720px;
		max-width: calc(100% - 3em);
		margin: 0 auto;
		padding: 0 1em;
	}
	.trust-pillars {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 0.75em 2.5em;
		flex-wrap: wrap;
		justify-content: center;
	}
	.trust-pillars li {
		display: flex;
		align-items: center;
		gap: 0.6em;
		font-size: 0.82em;
		color: var(--color-text-muted);
		letter-spacing: 0.03em;
	}
	.pillar-mark {
		color: var(--accent);
		font-size: 0.6em;
		opacity: 0.65;
	}

	/* ── Starter articles ─────────────────────────────────────── */
	.starter-section {
		width: 720px;
		max-width: calc(100% - 3em);
		margin: 0 auto;
		padding: 0 1em;
	}
	.starter-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.6rem 2rem;
	}
	.starter-link {
		display: block;
		font-family: var(--font-lora), serif;
		font-size: 0.85em;
		color: var(--accent);
		text-decoration: none;
		padding: 0.45em 0;
		border-bottom: 1px solid rgba(201, 169, 110, 0.15);
		transition: color 0.2s ease, border-color 0.2s ease;
		line-height: 1.45;
	}
	.starter-link::before {
		content: '→ ';
		opacity: 0.55;
		font-size: 0.9em;
	}
	.starter-link:hover {
		color: var(--accent-light);
		border-color: rgba(201, 169, 110, 0.4);
		text-decoration: none;
	}

	/* ── Topic hubs ──────────────────────────────────────────── */
	.hubs-section {
		width: 720px;
		max-width: calc(100% - 3em);
		margin: 0 auto;
		padding: 0 1em;
	}
	.hub-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		justify-content: center;
	}
	.hub-link {
		display: inline-block;
		font-family: var(--font-cinzel), serif;
		font-size: 0.65em;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		text-decoration: none;
		padding: 0.55em 1.1em;
		border: 1px solid rgba(201, 169, 110, 0.2);
		border-radius: 4px;
		transition:
			color 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease;
	}
	.hub-link:hover {
		color: var(--accent);
		border-color: rgba(201, 169, 110, 0.5);
		background: rgba(201, 169, 110, 0.04);
		text-decoration: none;
	}

	/* ── Guide CTA ────────────────────────────────────────────── */
	.guide-cta {
		width: 720px;
		max-width: calc(100% - 3em);
		margin: 0 auto;
		padding: 0 1em 5em;
		text-align: center;
	}
	.guide-cta-heading {
		font-size: clamp(1.2rem, 3.5vw, 1.8em);
		color: var(--color-heading);
		letter-spacing: 0.06em;
		margin-bottom: 0.5em;
	}
	.guide-cta-sub {
		font-size: 0.87em;
		color: var(--color-text-muted);
		max-width: 480px;
		margin: 0 auto 1.75em;
		line-height: 1.75;
	}

	@media (max-width: 600px) {
		.starter-links {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 380px) {
		.starter-links {
			grid-template-columns: 1fr;
		}
	}

	/* ── Responsive ──────────────────────────────────────────── */
	@media (max-width: 720px) {
		.hero {
			padding: 3em 1.25em 2.5em;
		}
		.path-steps {
			grid-template-columns: repeat(2, 1fr);
		}
		.path-card-art {
			right: -5%;
			top: 50%;
			bottom: auto;
			transform: translateY(-50%);
			height: 90%;
			max-width: none;
			opacity: 0.38;
		}
		/* On mobile the gradient overlay stays the same — text is left-anchored */
	}
	@media (max-width: 600px) {
		/* Portrait mobile: match desktop crop position so the palm stays in frame,
		   then use a left-heavy gradient so text reads on the left and the hand
		   shows through on the right */
		.hero-image {
			object-position: 65% center;
			filter: brightness(0.65) saturate(0.85);
		}
		.hero-image-wrap::after {
			background: linear-gradient(
				to right,
				rgba(13, 10, 26, 0.92) 0%,
				rgba(13, 10, 26, 0.68) 40%,
				rgba(13, 10, 26, 0.22) 100%
			);
		}
	}
	@media (max-width: 500px) {
		.hero {
			padding: 2.5em 1em 2em;
		}
		.hero h1 {
			letter-spacing: 0.04em;
		}
		.path-steps {
			grid-template-columns: 1fr;
		}
		.trust-pillars {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.9em;
		}
	}
</style>
