---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`The Palmistry Starter Guide — ${SITE_TITLE}`}
			description="A structured reference and observation guide for anyone beginning their study of palmistry. Covers the major lines, mounts, and hand shapes. Free to download."
		/>
		<style>
			/* ── Hero ─────────────────────────────────────────────────── */
			.guide-hero {
				text-align: center;
				padding: 4.5em 1em 2.5em;
				background: radial-gradient(
					ellipse 65% 50% at 50% 40%,
					rgba(201, 169, 110, 0.07) 0%,
					transparent 70%
				);
			}
			.guide-eyebrow {
				font-family: var(--font-cinzel), serif;
				font-size: 0.58em;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: var(--color-text-muted);
				margin: 0 0 1.1em;
				opacity: 0.7;
			}
			.guide-hero h1 {
				font-size: clamp(1.6rem, 6vw, 3em);
				letter-spacing: 0.08em;
				color: var(--accent);
				text-shadow:
					0 0 80px rgba(201, 169, 110, 0.18),
					0 2px 8px rgba(0, 0, 0, 0.7);
				margin: 0 0 0.5em;
			}
			.guide-hero .subline {
				font-size: 0.9em;
				color: var(--color-text-muted);
				max-width: 480px;
				margin: 0 auto;
				line-height: 1.75;
			}

			/* ── Divider ──────────────────────────────────────────────── */
			.divider {
				text-align: center;
				color: var(--accent);
				letter-spacing: 0.5em;
				font-size: 0.6em;
				opacity: 0.45;
				padding: 2.5em 0 0;
				margin-bottom: 2.5em;
			}

			/* ── Shared section wrapper ───────────────────────────────── */
			.guide-section {
				width: 640px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 0 1em;
			}

			/* ── What's inside ────────────────────────────────────────── */
			.section-heading {
				font-family: var(--font-cinzel), serif;
				font-size: 0.62em;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: var(--color-text-muted);
				opacity: 0.6;
				text-align: center;
				margin: 0 0 1.75em;
			}
			.contents-grid {
				list-style: none;
				margin: 0 0 3.5em;
				padding: 0;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.25em 2em;
			}
			.contents-grid li {
				border-top: 1px solid rgba(201, 169, 110, 0.15);
				padding-top: 0.9em;
			}
			.item-title {
				display: block;
				font-family: var(--font-cinzel), serif;
				font-size: 0.78em;
				letter-spacing: 0.06em;
				color: var(--color-heading);
				margin-bottom: 0.35em;
				line-height: 1.3;
			}
			.item-desc {
				display: block;
				font-size: 0.76em;
				color: var(--color-text-muted);
				line-height: 1.65;
				opacity: 0.8;
			}

			/* ── Signup block ─────────────────────────────────────────── */
			.signup-block {
				text-align: center;
				padding: 0 0 5em;
			}
			.signup-note {
				font-size: 0.87em;
				color: var(--color-text-muted);
				max-width: 440px;
				margin: 0 auto 1.5em;
				line-height: 1.75;
			}
			.signup-form {
				display: flex;
				gap: 0.7em;
				max-width: 460px;
				margin: 0 auto 0.85em;
			}
			.signup-form input[type='email'] {
				flex: 1;
				background: rgba(255, 255, 255, 0.04);
				border: 1px solid rgba(201, 169, 110, 0.28);
				border-radius: 4px;
				color: var(--color-text);
				font-family: var(--font-lora), serif;
				font-size: 0.82em;
				padding: 0.75em 1em;
				outline: none;
				transition:
					border-color 0.2s ease,
					box-shadow 0.2s ease;
				min-width: 0; /* prevent flex overflow */
			}
			.signup-form input[type='email']::placeholder {
				color: var(--color-text-muted);
				opacity: 0.55;
			}
			.signup-form input[type='email']:focus {
				border-color: rgba(201, 169, 110, 0.55);
				box-shadow: 0 0 0 3px rgba(201, 169, 110, 0.07);
			}
			.signup-form button {
				background: var(--accent);
				border: none;
				border-radius: 4px;
				color: var(--color-bg);
				font-family: var(--font-cinzel), serif;
				font-size: 0.68em;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				padding: 0.8em 1.5em;
				cursor: pointer;
				white-space: nowrap;
				transition:
					background 0.2s ease,
					box-shadow 0.2s ease;
			}
			.signup-form button:hover {
				background: var(--accent-light);
				box-shadow: 0 2px 14px rgba(201, 169, 110, 0.2);
			}
			.signup-form button:active {
				background: var(--accent);
				box-shadow: none;
			}
			.signup-form button:disabled {
				opacity: 0.55;
				cursor: not-allowed;
			}
			.signup-error {
				display: none;
				font-size: 0.78em;
				color: #c07870;
				margin: 0.5em 0 0;
			}
			.signup-caveat {
				font-size: 0.72em;
				color: var(--color-text-muted);
				opacity: 0.55;
				margin: 0;
				letter-spacing: 0.02em;
			}
			.caveat-link {
				color: inherit;
				text-decoration: underline;
				text-underline-offset: 2px;
				text-decoration-color: rgba(201, 169, 110, 0.3);
				transition: color 0.2s ease, text-decoration-color 0.2s ease;
			}
			.caveat-link:hover {
				color: var(--accent);
				text-decoration-color: rgba(201, 169, 110, 0.6);
			}
			/* ── Guide mockup ─────────────────────────────────────────── */
			.guide-mockup-wrap {
				text-align: center;
				margin: 0 auto 2.5em;
			}
			.guide-mockup {
				display: inline-block;
				width: 148px;
				height: 196px;
				background: linear-gradient(165deg, rgba(201, 169, 110, 0.09) 0%, rgba(13, 10, 26, 0.5) 100%);
				border: 1px solid rgba(201, 169, 110, 0.28);
				border-radius: 3px;
				position: relative;
				overflow: hidden;
				box-shadow:
					4px 8px 28px rgba(0, 0, 0, 0.55),
					0 0 0 1px rgba(0, 0, 0, 0.25);
				vertical-align: top;
			}
			.guide-mockup::before {
				content: '';
				position: absolute;
				inset: 0 0 auto;
				height: 2px;
				background: linear-gradient(
					90deg,
					transparent 0%,
					rgba(201, 169, 110, 0.65) 30%,
					rgba(201, 169, 110, 0.65) 70%,
					transparent 100%
				);
			}
			.mockup-inner {
				padding: 1.6em 1.1em 1em;
				height: 100%;
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
				gap: 0.45em;
			}
			.mockup-eyebrow {
				font-family: var(--font-cinzel), serif;
				font-size: 0.36em;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: var(--accent);
				opacity: 0.65;
			}
			.mockup-title-text {
				font-family: var(--font-cinzel), serif;
				font-size: 0.52em;
				color: var(--color-heading);
				line-height: 1.4;
				letter-spacing: 0.04em;
			}
			.mockup-rule {
				height: 1px;
				background: rgba(201, 169, 110, 0.18);
				margin: 0.2em 0;
			}
			.mockup-lines {
				display: flex;
				flex-direction: column;
				gap: 0.4em;
				margin-top: 0.2em;
			}
			.mockup-line {
				height: 1px;
				background: rgba(226, 217, 197, 0.1);
				border-radius: 1px;
			}
			.mockup-line:nth-child(odd) { width: 88%; }
			.mockup-line:nth-child(even) { width: 72%; }
			.mockup-line:last-child { width: 48%; }

			/* ── Made for section ─────────────────────────────────────── */
			.made-for-block {
				margin-bottom: 2.5em;
			}
			.made-for-text {
				font-size: 0.85em;
				color: var(--color-text-muted);
				text-align: center;
				border-left: 2px solid rgba(201, 169, 110, 0.22);
				padding: 0.7em 1.25em;
				margin: 0;
				line-height: 1.8;
				font-style: italic;
			}

			/* ── Preview download fallback ───────────────────────────── */
			.preview-download {
				text-align: center;
				padding: 2.25em 0 4.5em;
				border-top: 1px solid rgba(201, 169, 110, 0.1);
				margin-top: 1em;
			}
			.preview-download p {
				font-size: 0.78em;
				color: var(--color-text-muted);
				opacity: 0.6;
				margin: 0 0 0.9em;
				line-height: 1.6;
			}
			.preview-download-link {
				font-family: var(--font-cinzel), serif;
				font-size: 0.63em;
				letter-spacing: 0.13em;
				text-transform: uppercase;
				color: var(--color-text-muted);
				text-decoration: none;
				border-bottom: 1px solid rgba(201, 169, 110, 0.22);
				padding-bottom: 2px;
				opacity: 0.75;
				transition:
					color 0.2s ease,
					border-color 0.2s ease,
					opacity 0.2s ease;
			}
			.preview-download-link:hover {
				color: var(--accent);
				border-color: rgba(201, 169, 110, 0.5);
				opacity: 1;
			}

			/* ── How it works ─────────────────────────────────────────── */
			.how-it-works {
				margin-bottom: 2.5em;
			}
			.steps-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1em;
			}
			.steps-list li {
				display: flex;
				align-items: flex-start;
				gap: 1em;
			}
			.step-num {
				font-family: var(--font-cinzel), serif;
				font-size: 0.72em;
				color: var(--accent);
				opacity: 0.75;
				min-width: 1.4em;
				padding-top: 0.1em;
				letter-spacing: 0.05em;
			}
			.step-text {
				font-size: 0.87em;
				color: var(--color-text-muted);
				line-height: 1.7;
			}
			.step-text a {
				color: var(--accent);
				text-decoration: underline;
				text-underline-offset: 2px;
				text-decoration-color: rgba(201, 169, 110, 0.4);
				transition: color 0.2s ease, text-decoration-color 0.2s ease;
			}
			.step-text a:hover {
				color: var(--accent-light);
				text-decoration-color: rgba(201, 169, 110, 0.7);
			}

			/* ── Mobile ───────────────────────────────────────────────── */
			@media (max-width: 600px) {
				.guide-hero {
					padding: 3em 1em 2em;
				}
				.divider {
					padding-top: 1.75em;
					margin-bottom: 1.75em;
				}
				.contents-grid {
					grid-template-columns: 1fr;
					gap: 1.1em;
					margin-bottom: 2.5em;
				}
				.signup-form {
					flex-direction: column;
				}
				.signup-form button {
					width: 100%;
					padding: 0.85em 1em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="guide-hero">
				<p class="guide-eyebrow">Free Download</p>
				<h1>The Palmistry Starter Guide</h1>
				<p class="subline">
					Your printable companion to the Palmistry Path lessons — a structured overview of the major
					lines, mounts, and hand shapes to keep beside you while you study.
				</p>
			</section>

			<div class="divider" aria-hidden="true">✦ · ✦ · ✦</div>

			<div class="guide-section">
				<div class="guide-mockup-wrap" aria-hidden="true">
					<div class="guide-mockup">
						<div class="mockup-inner">
							<span class="mockup-eyebrow">Palmistry Path</span>
							<span class="mockup-title-text">Palmistry<br />Starter<br />Guide</span>
							<div class="mockup-rule"></div>
							<div class="mockup-lines">
								<div class="mockup-line"></div>
								<div class="mockup-line"></div>
								<div class="mockup-line"></div>
								<div class="mockup-line"></div>
								<div class="mockup-line"></div>
								<div class="mockup-line"></div>
								<div class="mockup-line"></div>
							</div>
						</div>
					</div>
				</div>
				<h2 class="section-heading">What's inside</h2>
				<ul class="contents-grid">
					<li>
						<span class="item-title">Major Lines Map</span>
						<span class="item-desc"
							>A reference diagram of the four major lines with their traditional names and
							locations.</span
						>
					</li>
					<li>
						<span class="item-title">Mount Meanings Overview</span>
						<span class="item-desc"
							>An overview of all eight mounts, their associated qualities, and how to assess
							prominence.</span
						>
					</li>
					<li>
						<span class="item-title">Hand Shape Guide</span>
						<span class="item-desc"
							>A visual key to the elemental hand types — Earth, Air, Fire, and Water — and their
							characteristic forms.</span
						>
					</li>
					<li>
						<span class="item-title">Printable Observation Sheet</span>
						<span class="item-desc"
							>A simple page for recording your own hand's features as you work through the
							lessons.</span
						>
					</li>
					<li style="grid-column: 1 / -1;">
						<span class="item-title">Beginner Reading Order</span>
						<span class="item-desc"
							>A suggested sequence for working through the major features — so you know where to
							start and what to build on first.</span
						>
					</li>
				</ul>
			</div>

			<div class="guide-section made-for-block">
				<p class="made-for-text">
					Best for beginners who want a calm, structured reference while working through the lessons
					— or anyone returning to palmistry who wants a clear overview in one place.
				</p>
			</div>

			<div class="guide-section how-it-works">
				<h2 class="section-heading">What happens next</h2>
				<ol class="steps-list">
					<li>
						<span class="step-num">1</span>
						<span class="step-text">Enter your email address below.</span>
					</li>
					<li>
						<span class="step-num">2</span>
						<span class="step-text">Receive the Starter Guide in your inbox — a printable PDF you can use alongside the lessons.</span>
					</li>
					<li>
						<span class="step-num">3</span>
						<span class="step-text">Open <a href="/learn/foundations/01-what-palmistry-is" data-track="link" data-track-location="guide-steps" data-track-target="lesson">Lesson 1</a> — the guide is designed to sit beside it.</span>
					</li>
				</ol>
			</div>

			<div class="guide-section signup-block">
				<p class="signup-note" id="signup-note">
					Enter your email and we'll send the Palmistry Starter Guide straight to your inbox — free,
					printable, and yours to keep.
				</p>

				<form
					class="signup-form"
					id="signup-form"
					action="https://app.kit.com/forms/9489555/subscriptions"
					method="post"
					aria-label="Guide download sign-up"
				>
					<label for="guide-email" class="sr-only">Email address</label>
					<input
						type="email"
						id="guide-email"
						name="email_address"
						placeholder="Your email address"
						autocomplete="email"
						required
					/>
					<button type="submit" id="signup-btn" data-track="cta" data-track-location="guide-form" data-track-target="guide-submit">Send Me the Guide</button>
				</form>
				<p class="signup-error" id="signup-error">Something went wrong — please try again.</p>
				<p class="signup-caveat" id="signup-caveat">
					You'll receive the guide and occasional Palmistry Path learning notes. <a href="/privacy/" class="caveat-link" data-track="nav" data-track-location="guide-caveat" data-track-target="privacy">Privacy policy.</a>
				</p>
			</div>

			<div class="guide-section preview-download">
				<p>Prefer to download and read offline?</p>
				<a
					href="/downloads/Palmistry-Starter-Guide-Web.pdf"
					download="Palmistry-Starter-Guide-Web.pdf"
					class="preview-download-link"
					data-track="link" data-track-location="guide-download" data-track-target="pdf-download"
				>↓ Download full guide (PDF, 25 MB)</a>
			</div>
		</main>
		<Footer />

		<script>
			const form = document.getElementById('signup-form') as HTMLFormElement | null;
			const btn = document.getElementById('signup-btn') as HTMLButtonElement | null;
			const errorMsg = document.getElementById('signup-error');

			form?.addEventListener('submit', async (e) => {
				e.preventDefault();

				if (!form.checkValidity()) {
					form.reportValidity();
					return;
				}

				const emailInput = form.querySelector<HTMLInputElement>('input[name="email_address"]');

				if (errorMsg) errorMsg.style.display = 'none';
				if (btn) { btn.textContent = 'Sending…'; btn.disabled = true; }

				try {
					const res = await fetch('https://app.kit.com/forms/9489555/subscriptions', {
						method: 'POST',
						headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
						body: new URLSearchParams({ email_address: emailInput.value }),
					});

					if (res.ok) {
						window.location.href = '/guide/thank-you/';
					} else {
						throw new Error('non-ok');
					}
				} catch {
					if (btn) { btn.textContent = 'Send Me the Guide'; btn.disabled = false; }
					if (errorMsg) errorMsg.style.display = 'block';
				}
			});
		</script>
	</body>
</html>
