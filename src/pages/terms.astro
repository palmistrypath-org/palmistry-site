---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Terms of Use — ${SITE_TITLE}`}
			description="Terms of use for Palmistry Path — an educational resource on palmistry. Content is for educational and reflective purposes only."
		/>
		<style>
			main section {
				margin-bottom: 2.5em;
			}
			main h2 {
				font-size: clamp(1.1rem, 3.5vw, 1.5em);
				margin-top: 2em;
				margin-bottom: 0.5em;
				padding-bottom: 0.35em;
				border-bottom: 1px solid rgba(201, 169, 110, 0.15);
			}
			.updated {
				font-size: 0.8em;
				color: var(--color-text-muted);
				opacity: 0.65;
				margin-bottom: 2em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Terms of Use</h1>
			<p class="updated">Last updated: May 2026</p>

			<section>
				<h2>Purpose of This Site</h2>
				<p>
					Palmistry Path is an independent educational resource. All content — articles, lessons,
					guides, and supporting materials — is provided for educational, informational, and
					reflective purposes only. By using this site, you accept these terms.
				</p>
			</section>

			<section>
				<h2>Not Professional Advice</h2>
				<p>
					Nothing on Palmistry Path constitutes or should be taken as medical, psychological, legal,
					financial, or any other form of professional advice. Content about palmistry describes an
					interpretive tradition and its cultural history — it is not a substitute for qualified
					professional guidance.
				</p>
				<p>
					If you have health concerns, legal questions, or financial decisions to make, consult an
					appropriately qualified professional.
				</p>
			</section>

			<section>
				<h2>No Predictive Claims</h2>
				<p>
					Palmistry Path does not claim that palmistry predicts future events, outcomes, or
					circumstances. Palmistry is presented here as a centuries-old interpretive and observational
					tradition — not as a science with verified predictive accuracy. No content on this site
					should be understood as a guarantee, forecast, or prediction of any kind.
				</p>
			</section>

			<section>
				<h2>Accuracy and Sources</h2>
				<p>
					We make reasonable efforts to ensure content is accurate, well-sourced, and clearly
					attributed to specific traditions. Where traditions disagree, we aim to say so. We cannot
					guarantee that every detail on this site is free from error. If you believe something is
					incorrect or misattributed, please use the <a href="/contact/">contact page</a> to let us
					know.
				</p>
			</section>

			<section>
				<h2>Intellectual Property</h2>
				<p>
					All original content on Palmistry Path — including articles, lesson text, and page copy
					— is the property of Palmistry Path and may not be reproduced without permission. Where
					content draws on published sources, those sources are attributed in the text.
				</p>
			</section>

			<section>
				<h2>External Links</h2>
				<p>
					Links to external websites (such as book sources or third-party services) are provided for
					convenience. We are not responsible for the content, accuracy, or privacy practices of
					external sites.
				</p>
			</section>

			<section>
				<h2>Changes to These Terms</h2>
				<p>
					These terms may be updated from time to time. The date at the top of this page reflects
					when they were last revised. Continued use of the site after changes are posted constitutes
					acceptance of the updated terms.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
