---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

type ClusterKey =
	| 'getting-started'
	| 'major-lines'
	| 'line-variations'
	| 'minor-lines'
	| 'mounts'
	| 'hand-shape'
	| 'traditions'
	| 'relationship-lines'
	| 'markings'
	| 'resources';

const clusterMeta: Record<ClusterKey, { label: string; intro: string }> = {
	'getting-started': {
		label: 'Getting Started',
		intro: 'New to palmistry? These articles cover the foundations.',
	},
	'major-lines': {
		label: 'Major Lines',
		intro: 'The heart, head, life, and fate lines — the core of every reading.',
	},
	'line-variations': {
		label: 'Line Variations',
		intro: 'Breaks, chains, forks, islands, and other variations on the main lines.',
	},
	'minor-lines': {
		label: 'Minor Lines',
		intro: 'Secondary lines that provide additional layers of interpretation.',
	},
	mounts: {
		label: 'Mounts',
		intro: 'The seven mounts of the palm and what each is traditionally associated with.',
	},
	'hand-shape': {
		label: 'Hand Shape & Features',
		intro: 'Hand types, finger shapes, thumbs, and nails as context for line reading.',
	},
	traditions: {
		label: 'Traditions',
		intro: 'Indian, Chinese, and Western palmistry — how the major traditions compare.',
	},
	'relationship-lines': {
		label: 'Relationship & Love Lines',
		intro: 'Marriage lines, love lines, and what palmistry can and cannot say about relationships.',
	},
	markings: {
		label: 'Markings',
		intro: 'Crosses, stars, islands, and other symbols found on the palm.',
	},
	resources: {
		label: 'Resources',
		intro: 'Books, charts, and reference materials for further study.',
	},
};

const clusterOrder: ClusterKey[] = [
	'getting-started',
	'major-lines',
	'line-variations',
	'minor-lines',
	'mounts',
	'hand-shape',
	'traditions',
	'relationship-lines',
	'markings',
	'resources',
];

// Group posts by cluster, ungrouped posts fall into a catch-all
const grouped = new Map<string, typeof allPosts>();
for (const key of clusterOrder) {
	grouped.set(key, []);
}
grouped.set('other', []);

for (const post of allPosts) {
	const key = post.data.cluster ?? 'other';
	const bucket = grouped.get(key) ?? grouped.get('other')!;
	bucket.push(post);
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Articles — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: calc(100% - 3rem);
				max-width: 1300px;
			}

			.page-header {
				margin-bottom: 2rem;
			}
			.page-header h1 {
				margin-bottom: 0.25rem;
			}
			.page-header p {
				margin: 0;
				color: var(--color-text-muted);
				font-size: 0.9em;
			}

			/* Cluster navigation bar */
			.cluster-nav {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 3rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid rgba(201, 169, 110, 0.15);
				list-style: none;
				padding-left: 0;
			}
			.cluster-nav a {
				display: inline-block;
				padding: 0.45em 0.75em;
				border: 1px solid rgba(201, 169, 110, 0.3);
				border-radius: 20px;
				font-size: 0.78em;
				font-family: var(--font-cinzel), serif;
				color: var(--color-nav-text);
				text-decoration: none;
				transition: 0.2s ease;
				white-space: nowrap;
			}
			.cluster-nav a:hover {
				border-color: var(--accent);
				color: var(--accent);
				background: rgba(201, 169, 110, 0.06);
			}

			/* Cluster sections */
			.cluster-section {
				margin-bottom: 3.5rem;
			}
			.cluster-section:last-child {
				margin-bottom: 0;
			}
			.cluster-heading {
				display: flex;
				align-items: baseline;
				gap: 0.75rem;
				margin-bottom: 0.4rem;
			}
			.cluster-heading h2 {
				margin: 0;
				font-size: clamp(1.1rem, 3.5vw, 1.5rem);
			}
			.cluster-count {
				font-size: 0.75em;
				color: var(--color-text-muted);
				font-family: var(--font-lora), serif;
			}
			.cluster-intro {
				margin: 0 0 1.25rem;
				color: var(--color-text-muted);
				font-size: 0.85em;
			}

			/* Article grid */
			.article-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.article-grid li a {
				display: block;
				height: 100%;
				padding: 1rem 1.1rem;
				border: 1px solid rgba(201, 169, 110, 0.2);
				border-radius: 10px;
				background: rgba(255, 255, 255, 0.02);
				text-decoration: none;
				transition: 0.2s ease;
				box-sizing: border-box;
			}
			.article-grid li a:hover {
				border-color: var(--accent);
				background: rgba(201, 169, 110, 0.05);
				box-shadow: var(--box-shadow);
			}
			.article-title {
				margin: 0 0 0.35rem;
				font-family: var(--font-cinzel), serif;
				font-size: 0.82em;
				color: var(--color-heading);
				line-height: 1.4;
			}
			.article-desc {
				margin: 0;
				font-size: 0.75em;
				color: var(--color-text-muted);
				line-height: 1.5;
			}

			/* Getting Started: slightly more prominent cards */
			.cluster-section.is-featured .article-grid {
				grid-template-columns: repeat(2, 1fr);
			}
			.cluster-section.is-featured .article-title {
				font-size: 0.9em;
			}
			.cluster-section.is-featured .article-desc {
				font-size: 0.8em;
			}
			.cluster-section.is-featured li a {
				border-color: rgba(201, 169, 110, 0.3);
				background: rgba(255, 255, 255, 0.03);
			}

			@media (max-width: 900px) {
				.article-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 600px) {
				main {
					width: calc(100% - 2rem);
				}
				.cluster-nav {
					gap: 0.4rem;
				}
				.article-grid,
				.cluster-section.is-featured .article-grid {
					grid-template-columns: 1fr;
					gap: 0.75rem;
				}
				.article-grid li a {
					padding: 0.85rem 1rem;
				}
				/* Raise small text floors on mobile */
				.article-desc {
					font-size: 0.8em;
				}
				.cluster-count {
					font-size: 0.85em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1">
			<header class="page-header">
				<h1>Articles</h1>
				<p>{allPosts.length} articles across {clusterOrder.length} topics</p>
			</header>

			<!-- Cluster navigation -->
			<nav aria-label="Browse by topic">
				<ul class="cluster-nav">
					{
						clusterOrder.map((key) => {
							const meta = clusterMeta[key];
							const count = grouped.get(key)?.length ?? 0;
							if (count === 0) return null;
							return (
								<li>
									<a href={`#${key}`}>{meta.label}</a>
								</li>
							);
						})
					}
				</ul>
			</nav>

			<!-- Cluster sections -->
			{
				clusterOrder.map((key) => {
					const posts = grouped.get(key) ?? [];
					if (posts.length === 0) return null;
					const meta = clusterMeta[key];
					const isFeatured = key === 'getting-started';
					return (
						<section
							id={key}
							class={`cluster-section${isFeatured ? ' is-featured' : ''}`}
						>
							<div class="cluster-heading">
								<h2>{meta.label}</h2>
								<span class="cluster-count">{posts.length} articles</span>
							</div>
							<p class="cluster-intro">{meta.intro}</p>
							<ul class="article-grid">
								{posts.map((post) => (
									<li>
										<a href={`/blog/${post.id}/`}>
											<h3 class="article-title">{post.data.title}</h3>
											<p class="article-desc">
												{post.data.description.length > 110
													? post.data.description.slice(0, 110) + '…'
													: post.data.description}
											</p>
										</a>
									</li>
								))}
							</ul>
						</section>
					);
				})
			}

			<!-- Catch-all for any post without a cluster -->
			{
				(grouped.get('other') ?? []).length > 0 && (
					<section id="other" class="cluster-section">
						<div class="cluster-heading">
							<h2>Other Articles</h2>
							<span class="cluster-count">{grouped.get('other')!.length} articles</span>
						</div>
						<ul class="article-grid">
							{(grouped.get('other') ?? []).map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<h3 class="article-title">{post.data.title}</h3>
										<p class="article-desc">
											{post.data.description.length > 110
												? post.data.description.slice(0, 110) + '…'
												: post.data.description}
										</p>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>
