---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`The Complete Palmistry Reference — ${SITE_TITLE}`}
			description="A thorough, printable reference for serious palmistry students. Covers all major and minor lines, all seven mounts, hand shapes, markings, and cross-tradition comparisons in one guide."
		/>
		<style>
			/* ── Hero ─────────────────────────────────────────────────── */
			.hero {
				text-align: center;
				padding: 4.5em 1em 2.5em;
				background: radial-gradient(
					ellipse 65% 50% at 50% 40%,
					rgba(201, 169, 110, 0.07) 0%,
					transparent 70%
				);
			}
			.eyebrow {
				font-family: var(--font-cinzel), serif;
				font-size: 0.58em;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: var(--color-text-muted);
				margin: 0 0 1.1em;
			}
			.hero h1 {
				font-size: clamp(1.6rem, 6vw, 3em);
				letter-spacing: 0.08em;
				color: var(--color-heading);
				margin: 0 0 0.45em;
			}
			.hero-sub {
				font-size: 0.9em;
				color: var(--color-text-muted);
				max-width: 500px;
				margin: 0 auto 2em;
				line-height: 1.75;
			}
			.status-block {
				display: inline-flex;
				flex-direction: column;
				align-items: center;
				gap: 0.2em;
				margin-bottom: 1.5em;
			}
			.status {
				font-family: var(--font-cinzel), serif;
				font-size: clamp(1.6rem, 5vw, 2.4em);
				color: var(--color-heading);
				letter-spacing: 0.05em;
			}
			.status-note {
				font-size: 0.75em;
				color: var(--color-text-muted);
			}
			.btn-buy {
				display: inline-block;
				background: var(--accent);
				color: var(--color-bg);
				font-family: var(--font-cinzel), serif;
				font-size: 0.72em;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				text-decoration: none;
				padding: 1em 2.2em;
				border-radius: 4px;
				transition: background 0.2s ease, box-shadow 0.2s ease;
				margin-bottom: 0.75em;
			}
			.btn-buy:hover {
				background: var(--accent-light);
				box-shadow: 0 2px 18px rgba(201, 169, 110, 0.22);
				text-decoration: none;
			}
			.guarantee {
				font-size: 0.73em;
				color: var(--color-text-muted);
			}

			/* ── Divider ──────────────────────────────────────────────── */
			.divider {
				text-align: center;
				color: var(--accent);
				letter-spacing: 0.5em;
				font-size: 0.6em;
				opacity: 0.45;
				padding: 2.5em 0 0;
				margin-bottom: 2.5em;
			}

			/* ── Shared wrapper ───────────────────────────────────────── */
			.section {
				width: 680px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 0 1em;
			}

			/* ── Section heading ──────────────────────────────────────── */
			.section-heading {
				font-family: var(--font-cinzel), serif;
				font-size: 0.62em;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: var(--color-text-muted);
				text-align: center;
				margin: 0 0 1.75em;
			}

			/* ── Contents grid ────────────────────────────────────────── */
			.contents-grid {
				list-style: none;
				margin: 0 0 3.5em;
				padding: 0;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.25em 2em;
			}
			.contents-grid li {
				border-top: 1px solid rgba(201, 169, 110, 0.15);
				padding-top: 0.9em;
			}
			.item-title {
				display: block;
				font-family: var(--font-cinzel), serif;
				font-size: 0.78em;
				letter-spacing: 0.06em;
				color: var(--color-heading);
				margin-bottom: 0.35em;
				line-height: 1.3;
			}
			.item-desc {
				display: block;
				font-size: 0.76em;
				color: var(--color-text-muted);
				line-height: 1.65;
			}

			/* ── Comparison ───────────────────────────────────────────── */
			.comparison-table {
				width: 100%;
				border-collapse: collapse;
				font-size: 0.82em;
				margin: 0 0 3.5em;
			}
			.comparison-table th {
				font-family: var(--font-cinzel), serif;
				font-size: 0.72em;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: var(--color-text-muted);
				padding: 0.7em 1em;
				text-align: left;
				border-bottom: 1px solid rgba(201, 169, 110, 0.2);
			}
			.comparison-table th:last-child {
				color: var(--accent);
				opacity: 1;
			}
			.comparison-table td {
				padding: 0.65em 1em;
				color: var(--color-text-muted);
				border-bottom: 1px solid rgba(201, 169, 110, 0.08);
				line-height: 1.5;
			}
			.comparison-table td:first-child {
				color: var(--color-text);
			}
			.check {
				color: var(--accent);
				opacity: 0.85;
			}
			.dash {
				opacity: 0.3;
			}

			/* ── Made for ─────────────────────────────────────────────── */
			.made-for {
				font-size: 0.85em;
				color: var(--color-text-muted);
				border-left: 2px solid rgba(201, 169, 110, 0.22);
				padding: 0.7em 1.25em;
				margin: 0 0 3.5em;
				line-height: 1.8;
				font-style: italic;
			}

			/* ── Bottom CTA ───────────────────────────────────────────── */
			.bottom-cta {
				text-align: center;
				padding: 0 0 5em;
			}
			.bottom-cta-note {
				font-size: 0.87em;
				color: var(--color-text-muted);
				max-width: 440px;
				margin: 0 auto 1.5em;
				line-height: 1.75;
			}
			.free-link {
				display: block;
				margin-top: 1.5em;
				font-size: 0.75em;
				color: var(--color-text-muted);
				text-decoration: none;
				transition: color 0.2s ease;
			}
			.free-link:hover {
				color: var(--accent);
				text-decoration: underline;
				text-underline-offset: 2px;
			}

			/* ── Notify section ───────────────────────────────────────── */
			.notify-section {
				text-align: center;
				padding: 3em 1em 2em;
				border-top: 1px solid rgba(201, 169, 110, 0.15);
			}
			.notify-note {
				font-size: 0.88em;
				color: var(--color-text-muted);
				max-width: 480px;
				margin: 0 auto 1.75em;
				line-height: 1.75;
			}
			.notify-form-wrap {
				max-width: 420px;
				margin: 0 auto;
			}
			#notify-form {
				display: flex;
				gap: 0.5em;
				flex-wrap: wrap;
				justify-content: center;
			}
			.form-field {
				flex: 1 1 220px;
				min-width: 0;
				text-align: left;
			}
			.form-label {
				display: block;
				margin: 0 0 0.35em;
				color: var(--color-text);
				font-family: var(--font-cinzel);
				font-size: 0.62em;
				letter-spacing: 0.11em;
				text-transform: uppercase;
			}
			#notify-form input[type="email"] {
				width: 100%;
				box-sizing: border-box;
				padding: 0.65em 1em;
				border: 1px solid rgba(201, 169, 110, 0.35);
				border-radius: 4px;
				background: var(--color-surface);
				color: var(--color-text);
				font-family: var(--font-lora);
				font-size: 0.9em;
			}
			#notify-form input[type="email"]::placeholder {
				color: var(--color-text-muted);
				opacity: 0.75;
			}
			#notify-form button {
				padding: 0.65em 1.25em;
				background: var(--color-gold);
				color: #1a1208;
				border: none;
				border-radius: 4px;
				font-family: var(--font-cinzel);
				font-size: 0.8em;
				letter-spacing: 0.04em;
				cursor: pointer;
				transition: opacity 0.2s ease;
				white-space: nowrap;
			}
			#notify-form button:hover { opacity: 0.85; }
			.notify-caveat {
				font-size: 0.72em;
				color: var(--color-text-muted);
				margin-top: 0.9em;
				line-height: 1.6;
			}
			.notify-caveat a { color: inherit; }
			.notify-error, .notify-success {
				font-size: 0.82em;
				margin-top: 0.75em;
			}
			.notify-success { color: var(--color-gold-ink); }
			.notify-error { color: #e07070; }

			/* ── Mobile ───────────────────────────────────────────────── */
			@media (max-width: 600px) {
				.hero { padding: 3em 1em 2em; }
				.contents-grid { grid-template-columns: 1fr; gap: 1.1em; margin-bottom: 2.5em; }
				.comparison-table th, .comparison-table td { padding: 0.55em 0.6em; }
				#notify-form { flex-direction: column; align-items: stretch; }
				.form-field, #notify-form button { flex: none; width: 100%; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1">
			<section class="hero">
				<p class="eyebrow">Palmistry Path — Complete Reference</p>
				<h1>The Complete Palmistry Reference</h1>
				<p class="hero-sub">
					Everything in the free Starter Guide, plus the full detail that serious students need —
					line variations, mount combinations, minor lines, markings, and cross-tradition comparisons,
					in one printable reference.
				</p>
				<div class="status-block">
					<span class="status">Waitlist only</span>
					<span class="status-note">The printable PDF is not available for purchase yet</span>
				</div>
				<br />
				<a
					href="#notify-form"
					class="btn-buy"
					data-track="cta"
					data-track-location="premium-guide-hero"
					data-track-target="waitlist"
				>Join the Waitlist →</a>
				<br />
				<span class="guarantee">We'll email you when the Complete Reference is ready.</span>
			</section>

			<div class="divider" aria-hidden="true">✦ · ✦ · ✦</div>

			<div class="section">
				<h2 class="section-heading">What's inside</h2>
				<ul class="contents-grid">
					<li>
						<span class="item-title">Major Lines in Full Detail</span>
						<span class="item-desc">Every significant variation of the Heart, Head, Life, and Fate lines — branches, breaks, islands, chains, forks, and endings — with traditional associations from Western, Indian, and Chinese sources.</span>
					</li>
					<li>
						<span class="item-title">All Seven Mounts</span>
						<span class="item-desc">Complete coverage of each mount: Jupiter, Saturn, Apollo, Mercury, Venus, Luna, and both mounts of Mars — with dominant, deficient, and combined readings.</span>
					</li>
					<li>
						<span class="item-title">Minor Lines and Markings</span>
						<span class="item-desc">The Sun line, Mercury line, Girdle of Venus, Marriage lines, Travel lines, Simian line — plus crosses, stars, triangles, grilles, and islands explained and sourced.</span>
					</li>
					<li>
						<span class="item-title">Hand Shape Visual Guide</span>
						<span class="item-desc">The four elemental hand types with distinguishing characteristics, how to identify them in practice, and what combinations look like.</span>
					</li>
					<li>
						<span class="item-title">Finger and Thumb Analysis</span>
						<span class="item-desc">Finger length, shape, and phalange readings — including the Jupiter, Saturn, Apollo, and Mercury fingers — plus thumb angle, flexibility, and section proportions.</span>
					</li>
					<li>
						<span class="item-title">Cross-Tradition Comparison Tables</span>
						<span class="item-desc">Side-by-side summaries of how Western, Indian, and Chinese palmistry interpret the major features differently — honest about disagreement rather than synthesising false consensus.</span>
					</li>
					<li>
						<span class="item-title">Active and Passive Hand Guide</span>
						<span class="item-desc">A practical guide to reading both hands in combination, including what to look for when the lines differ significantly between dominant and non-dominant hand.</span>
					</li>
					<li style="grid-column: 1 / -1;">
						<span class="item-title">Practice Reading Checklist</span>
						<span class="item-desc">A structured sequence for working through a full hand reading from first observation to synthesis — with an extended observation sheet for recording your findings.</span>
					</li>
				</ul>
			</div>

			<div class="section">
				<h2 class="section-heading">Free guide vs. complete reference</h2>
				<table class="comparison-table">
					<thead>
						<tr>
							<th>Feature</th>
							<th>Free Starter Guide</th>
							<th>Complete Reference</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td>Major lines overview</td>
							<td class="check">✓</td>
							<td class="check">✓ with all variations</td>
						</tr>
						<tr>
							<td>Mount meanings</td>
							<td class="check">✓ summary</td>
							<td class="check">✓ all 7, full detail</td>
						</tr>
						<tr>
							<td>Hand shape guide</td>
							<td class="check">✓ four types</td>
							<td class="check">✓ with identification guide</td>
						</tr>
						<tr>
							<td>Minor lines (Sun, Mercury, etc.)</td>
							<td class="dash">—</td>
							<td class="check">✓</td>
						</tr>
						<tr>
							<td>Markings (crosses, stars, islands)</td>
							<td class="dash">—</td>
							<td class="check">✓</td>
						</tr>
						<tr>
							<td>Finger and thumb readings</td>
							<td class="dash">—</td>
							<td class="check">✓</td>
						</tr>
						<tr>
							<td>Cross-tradition comparison tables</td>
							<td class="dash">—</td>
							<td class="check">✓ Western / Indian / Chinese</td>
						</tr>
						<tr>
							<td>Practice reading sequence</td>
							<td>Basic observation sheet</td>
							<td class="check">✓ structured checklist</td>
						</tr>
					</tbody>
				</table>
			</div>

			<div class="section">
				<p class="made-for">
					Best for students who have moved past the basics — who can identify the major lines and want
					a thorough desk reference for the detail work: variations, combinations, and the occasional
					cross-tradition disagreement that the overview articles don't have room to cover.
				</p>
			</div>

			<div class="section notify-section">
				<h2 class="section-heading">Get notified when it's available</h2>
				<p class="notify-note" id="notify-note">
					The Complete Reference is in final preparation. Leave your email and we'll send you a link when it's ready.
				</p>
				<div class="notify-form-wrap">
					<form
						id="notify-form"
						action="https://app.kit.com/forms/9489555/subscriptions"
						method="post"
						aria-label="Notify me when available"
					>
						<div class="form-field">
							<label for="notify-email" class="form-label">Email address</label>
							<input
								type="email"
								id="notify-email"
								name="email_address"
								placeholder="you@example.com"
								autocomplete="email"
								aria-describedby="notify-note notify-error notify-success notify-caveat"
								required
							/>
						</div>
						<button type="submit" id="notify-btn" data-track="cta" data-track-location="premium-guide-notify" data-track-target="notify-submit">Notify Me →</button>
					</form>
					<p class="notify-error" id="notify-error" role="alert" style="display:none;">Something went wrong — please try again.</p>
					<p class="notify-success" id="notify-success" role="status" aria-live="polite" style="display:none;">You're on the list. We'll email you when it's ready.</p>
					<p class="notify-caveat" id="notify-caveat">No spam. Just the launch email and occasional Palmistry Path notes. <a href="/privacy/" class="caveat-link">Privacy policy.</a></p>
				</div>
			</div>

			<div class="section bottom-cta">
				<p class="bottom-cta-note">
					The printable reference is not available for purchase yet. Join the waitlist to hear when it is ready.
				</p>
				<a
					href="#notify-form"
					class="btn-buy"
					data-track="cta"
					data-track-location="premium-guide-bottom"
					data-track-target="waitlist"
				>Join the Waitlist →</a>
				<a href="/guide/" class="free-link" data-track="link" data-track-location="premium-guide-bottom" data-track-target="free-guide">
					Not ready yet? The free Starter Guide is a good place to start.
				</a>
			</div>
		</main>
		<Footer />
		<script>
			const form = document.getElementById('notify-form') as HTMLFormElement | null;
			const btn = document.getElementById('notify-btn') as HTMLButtonElement | null;
			const errorMsg = document.getElementById('notify-error');
			const successMsg = document.getElementById('notify-success');
			const emailInput = document.getElementById('notify-email') as HTMLInputElement | null;

			form?.addEventListener('submit', async (e) => {
				e.preventDefault();
				if (!form.checkValidity()) {
					form.reportValidity();
					return;
				}
				if (!emailInput?.value || !btn) return;
				if (errorMsg) errorMsg.style.display = 'none';
				if (successMsg) successMsg.style.display = 'none';
				btn.textContent = 'Submitting…';
				btn.disabled = true;
				try {
					const res = await fetch('https://app.kit.com/forms/9489555/subscriptions', {
						method: 'POST',
						headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
						body: new URLSearchParams({ email_address: emailInput.value }),
					});
					if (res.ok) {
						form.style.display = 'none';
						if (successMsg) successMsg.style.display = 'block';
					} else {
						throw new Error('non-ok');
					}
				} catch {
					if (btn) { btn.textContent = 'Notify Me →'; btn.disabled = false; }
					if (errorMsg) errorMsg.style.display = 'block';
				}
			});
		</script>
	</body>
</html>
